<!-- MODAL: CREATE STAFF (staff.create) -->
<!-- ============================================================== -->
<div class="modal fade" id="createStaffModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form asp-action="CreateStaff" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom py-3 px-4">
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0">Thêm Tài Khoản Nhân Viên Mới</h5>
                        <span class="text-muted small">Cấp phát tài khoản cho Sales, Kho, Kỹ thuật hoặc Kế toán</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small text-dark">Họ và tên nhân viên <span class="text-danger">*</span></label>
                            <input type="text" name="FullName" class="form-control rounded-3" placeholder="VD: Nguyễn Văn An" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small text-dark">Email đăng nhập (Công ty) <span class="text-danger">*</span></label>
                            <input type="email" name="Email" class="form-control rounded-3" placeholder="VD: an.nguyen@techzone.vn" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small text-dark">Số điện thoại</label>
                            <input type="text" name="PhoneNumber" class="form-control rounded-3" placeholder="VD: 0912345678" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small text-dark">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                            <input type="password" name="Password" class="form-control rounded-3" placeholder="Mật khẩu ít nhất 6 ký tự" required />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold small text-dark">Vai trò cốt lõi (Base Role) <span class="text-danger">*</span></label>
                            <select name="Role" class="form-select rounded-3">
                                <option value="SalesStaff">💼 Bán Hàng & CSKH (Sales)</option>
                                <option value="WarehouseStaff">📦 Thủ Kho & IMEI (Warehouse)</option>
                                <option value="Technician">🔧 Kỹ Thuật Viên (Technician)</option>
                                <option value="Accountant">💰 Kế Toán (Accountant)</option>
                                <option value="MarketingStaff">📢 Marketing & SEO (Marketing)</option>
                                <option value="SuperAdmin">👑 Quản Trị Viên (SuperAdmin)</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold small text-dark">Chức danh mở rộng (Role Doanh nghiệp)</label>
                            <select name="CustomRoleId" class="form-select rounded-3">
                                <option value="">-- Mặc định theo Base Role --</option>
                                @foreach (var r in Model.Roles.Where(r => !r.IsSystem))
                                {
                                    <option value="@r.Id">@r.Name (@r.Code)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold small text-dark">Phòng ban</label>
                            <input type="text" name="Department" class="form-control rounded-3" placeholder="VD: Kinh Doanh, Kho Vận, Kỹ Thuật" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top py-3 px-4">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                        <i class="bi bi-person-check-fill me-1"></i>Tạo Tài Khoản
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

