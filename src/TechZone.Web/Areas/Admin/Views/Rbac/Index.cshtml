<!-- MODAL: CREATE ROLE (role.manage) -->
<!-- ============================================================== -->
<div class="modal fade" id="createRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form asp-action="CreateRole" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom py-3 px-4">
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0">Tạo Nhóm Vai Trò (Role) Doanh Nghiệp Mới</h5>
                        <span class="text-muted small">Định nghĩa chức danh công ty và gán danh mục quyền hạn tương ứng</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small text-dark">Tên vai trò mới <span class="text-danger">*</span></label>
                            <input type="text" name="Name" class="form-control rounded-3" placeholder="VD: Trưởng Phòng Kinh Doanh, Kế Toán Trưởng..." required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small text-dark">Mã định danh Role (Code) <span class="text-danger">*</span></label>
                            <input type="text" name="Code" class="form-control font-monospace text-uppercase rounded-3" placeholder="VD: SALES_LEAD, CHIEF_ACCOUNTANT..." required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small text-dark">Khuôn mẫu cơ sở (Base Role) <span class="text-danger">*</span></label>
                            <select name="BaseRole" class="form-select rounded-3">
                                <option value="SalesStaff">💼 Bán Hàng & CSKH (Sales)</option>
                                <option value="WarehouseStaff">📦 Thủ Kho & IMEI (Warehouse)</option>
                                <option value="Technician">🔧 Kỹ Thuật Viên (Technician)</option>
                                <option value="Accountant">💰 Kế Toán (Accountant)</option>
                                <option value="MarketingStaff">📢 Marketing & SEO (Marketing)</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small text-dark">Phòng ban phụ trách</label>
                            <input type="text" name="Department" class="form-control rounded-3" placeholder="VD: Khối Kinh Doanh, Phòng Kỹ Thuật..." />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small text-dark">Mô tả trách nhiệm & quyền hạn</label>
                            <input type="text" name="Description" class="form-control rounded-3" placeholder="VD: Chịu trách nhiệm duyệt đơn hàng lớn, xử lý sự cố địa chỉ giao hàng và đổi trả..." />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                        <span class="fw-bold small text-dark text-uppercase">Danh mục quyền hạn gán cho Role</span>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2" onclick="toggleAllCheckboxes('createRolePerms', true)">Chọn tất cả</button>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2" onclick="toggleAllCheckboxes('createRolePerms', false)">Bỏ chọn</button>
                        </div>
                    </div>

                    <div id="createRolePerms" style="max-height: 280px; overflow-y: auto;" class="pe-2">
                        @foreach (var g in Model.PermissionGroups)
                        {
                            <div class="card border rounded-3 p-2.5 bg-light mb-2">
                                <div class="fw-bold small text-dark mb-2">
                                    <i class="bi @g.Icon me-1 text-primary"></i>@g.Category
                                </div>
                                <div class="row g-2">
                                    @foreach (var p in g.Permissions)
                                    {
                                        <div class="col-12 col-md-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="Permissions" value="@p.Code" id="chkCreateRole_@p.Code.Replace('.', '_')" />
                                                <label class="form-check-label small" for="chkCreateRole_@p.Code.Replace('.', '_')">
                                                    <span class="fw-semibold text-dark">@p.Name</span>
                                                    <span class="text-muted d-block" style="font-size: 0.68rem;">@p.Code</span>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-top py-3 px-4">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                        <i class="bi bi-shield-check me-1"></i>Lưu & Tạo Role
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- MODAL: EDIT ROLE (role.manage) -->
<!-- ============================================================== -->
<div class="modal fade" id="updateRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form asp-action="UpdateRole" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="RoleId" id="editRoleId" />
                <div class="modal-header border-bottom py-3 px-4">
                    <h5 class="modal-title fw-bold text-dark mb-0">Chỉnh Sửa Nhóm Vai Trò</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Tên vai trò <span class="text-danger">*</span></label>
                        <input type="text" name="Name" id="editRoleName" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Phòng ban</label>
                        <input type="text" name="Department" id="editRoleDept" class="form-control rounded-3" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Mô tả trách nhiệm</label>
                        <textarea name="Description" id="editRoleDesc" class="form-control rounded-3" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top py-3 px-4">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i>Lưu Thay Đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- MODAL: DYNAMIC PERMISSION ASSIGNMENT (permission.assign) -->
<!-- ============================================================== -->
<div class="modal fade" id="assignPermsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form asp-action="AssignPermissions" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TargetType" id="assignPermTargetType" />
                <input type="hidden" name="TargetId" id="assignPermTargetId" />
                <div class="modal-header border-bottom py-3 px-4">
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="assignPermHeaderTitle">Gán & Thu Hồi Quyền Hạn Cụ Thể</h5>
                        <span class="text-muted small" id="assignPermHeaderSub"></span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="fw-semibold small text-secondary text-uppercase">Danh mục quyền hạn khả dụng</span>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2.5" onclick="toggleAllCheckboxes('assignPermsContainer', true)">Chọn tất cả</button>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2.5" onclick="toggleAllCheckboxes('assignPermsContainer', false)">Bỏ chọn tất cả</button>
                        </div>
                    </div>

                    <div id="assignPermsContainer" style="max-height: 380px; overflow-y: auto;" class="pe-2">
                        @foreach (var g in Model.PermissionGroups)
                        {
                            <div class="card border rounded-3 p-3 bg-light mb-3">
                                <div class="fw-bold small text-dark mb-2.5 d-flex align-items-center gap-1.5">
                                    <i class="bi @g.Icon text-primary"></i>
                                    <span>@g.Category</span>
                                    <span class="badge bg-white text-secondary border rounded-pill ms-auto" style="font-size: 0.68rem;">@g.Permissions.Count quyền</span>
                                </div>
                                <div class="row g-2">
                                    @foreach (var p in g.Permissions)
                                    {
                                        <div class="col-12 col-md-6">
                                            <div class="form-check p-2 bg-white rounded-3 border">
                                                <input class="form-check-input perm-chk ms-1" type="checkbox" name="Permissions" value="@p.Code" id="chkAssign_@p.Code.Replace('.', '_')" />
                                                <label class="form-check-label small ms-2" for="chkAssign_@p.Code.Replace('.', '_')">
                                                    <span class="fw-semibold text-dark d-block">@p.Name</span>
                                                    <span class="text-muted font-monospace" style="font-size: 0.68rem;">@p.Code</span>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-top py-3 px-4">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                        <i class="bi bi-shield-check me-1"></i>Lưu Phân Quyền
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleAllCheckboxes(containerId, check) {
            const container = document.getElementById(containerId);
            if (container) {
                container.querySelectorAll('input[type="checkbox"]').forEach(c => c.checked = check);
            }
        }

        // Bind Edit Staff Modal
        document.querySelectorAll('.btn-edit-staff').forEach(btn => {
            btn.addEventListener('click', function () {
                document.getElementById('editStaffUserId').value = this.getAttribute('data-user-id');
                document.getElementById('editStaffFullName').value = this.getAttribute('data-user-name');
                document.getElementById('editStaffHeaderEmail').innerText = `Email: ${this.getAttribute('data-user-email')}`;
                document.getElementById('editStaffPhone').value = this.getAttribute('data-user-phone') || '';
                document.getElementById('editStaffRole').value = this.getAttribute('data-user-role');
                document.getElementById('editStaffDept').value = this.getAttribute('data-user-dept') || '';
                document.getElementById('editStaffCustomRole').value = this.getAttribute('data-user-customrole') || '';
                document.getElementById('editStaffIsActive').checked = this.getAttribute('data-user-active') === 'true';

                const modal = new bootstrap.Modal(document.getElementById('updateStaffModal'));
                modal.show();
            });
        });

        // Bind Edit Role Modal
        document.querySelectorAll('.btn-edit-role').forEach(btn => {
            btn.addEventListener('click', function () {
                document.getElementById('editRoleId').value = this.getAttribute('data-role-id');
                document.getElementById('editRoleName').value = this.getAttribute('data-role-name');
                document.getElementById('editRoleDept').value = this.getAttribute('data-role-dept') || '';
                document.getElementById('editRoleDesc').value = this.getAttribute('data-role-desc') || '';

                const modal = new bootstrap.Modal(document.getElementById('updateRoleModal'));
                modal.show();
            });
        });

        // Bind Assign User Permissions
        document.querySelectorAll('.btn-assign-user-perms').forEach(btn => {
            btn.addEventListener('click', function () {
                const userId = this.getAttribute('data-user-id');
                const userName = this.getAttribute('data-user-name');
                const perms = JSON.parse(this.getAttribute('data-perms') || '[]');

                document.getElementById('assignPermTargetType').value = 'User';
                document.getElementById('assignPermTargetId').value = userId;
                document.getElementById('assignPermHeaderTitle').innerText = `Phân Quyền Cho Nhân Viên: ${userName}`;
                document.getElementById('assignPermHeaderSub').innerText = 'Tùy biến quyền hạn đặc thù ghi đè cho tài khoản cá nhân';

                // Check active permissions
                document.querySelectorAll('#assignPermsContainer .perm-chk').forEach(chk => {
                    chk.checked = perms.includes(chk.value);
                });

                const modal = new bootstrap.Modal(document.getElementById('assignPermsModal'));
                modal.show();
            });
        });

        // Bind Assign Role Permissions
        document.querySelectorAll('.btn-assign-role-perms').forEach(btn => {
            btn.addEventListener('click', function () {
                const roleId = this.getAttribute('data-role-id');
                const roleName = this.getAttribute('data-role-name');
                const perms = JSON.parse(this.getAttribute('data-perms') || '[]');

                document.getElementById('assignPermTargetType').value = 'Role';
                document.getElementById('assignPermTargetId').value = roleId;
                document.getElementById('assignPermHeaderTitle').innerText = `Phân Quyền Cho Role: ${roleName}`;
                document.getElementById('assignPermHeaderSub').innerText = 'Mọi nhân sự được gán Role này sẽ tự động kế thừa bộ quyền bên dưới';

                // Check active permissions
                document.querySelectorAll('#assignPermsContainer .perm-chk').forEach(chk => {
                    chk.checked = perms.includes(chk.value);
                });

                const modal = new bootstrap.Modal(document.getElementById('assignPermsModal'));
                modal.show();
            });
        });
    </script>
}
