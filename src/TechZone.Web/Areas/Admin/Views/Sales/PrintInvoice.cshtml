@using TechZone.Domain.Enums
@model TechZone.Domain.Entities.Order
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Hóa Đơn Bán Lẻ & Phiếu Tạm Tính - @Model.OrderCode</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <style>
        @@media print {
            .no-print {
                display: none !important;
            }
            body {
                margin: 0;
                padding: 10mm;
            }
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: #1e293b;
            background: #f8fafc;
        }
        .invoice-card {
            width: 750px;
            margin: 20px auto;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            padding: 30px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.06);
            border-radius: 8px;
        }
    </style>
</head>
<body class="p-4">
    <div class="text-center no-print mb-3">
        <button onclick="window.print()" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
            🖨️ In Hóa Đơn Bán Lẻ (Print Invoice)
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary rounded-pill px-4 ms-2">Đóng</button>
    </div>

    <div class="invoice-card">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
            <div>
                <h3 class="fw-bold text-dark mb-1">TECHZONE VIỆT NAM</h3>
                <div class="text-secondary small">Hệ thống phân phối Thiết bị & Công nghệ chính hãng</div>
                <div class="text-secondary small">Hotline: 1900 8888 | Website: https://techzone.vn</div>
            </div>
            <div class="text-end">
                <svg id="invoiceBarcode"></svg>
                <div class="font-monospace fw-bold fs-6">@Model.OrderCode</div>
                <div class="small text-muted">Ngày: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <div class="text-center my-3">
            <h4 class="fw-bold text-dark text-uppercase mb-1">HÓA ĐƠN BÁN LẺ &amp; PHIẾU XUẤT KHO</h4>
            <div class="text-muted small">Phiếu tạm tính kiêm biên bản giao nhận hàng hóa</div>
        </div>

        <!-- Customer & Order Details -->
        <div class="row g-3 bg-light p-3 rounded-3 mb-3">
            <div class="col-6">
                <div class="small text-secondary">Khách hàng: <strong>@Model.CustomerName</strong></div>
                <div class="small text-secondary">Số điện thoại: <strong>@Model.CustomerPhone</strong></div>
                <div class="small text-secondary">Địa chỉ: @Model.ShippingAddress.FullAddress</div>
            </div>
            <div class="col-6">
                <div class="small text-secondary">Kênh bán: <strong>@Model.SourceChannel</strong></div>
                <div class="small text-secondary">Nhân viên chốt: <strong>@(string.IsNullOrEmpty(Model.AssignedStaffName) ? "Telesales" : Model.AssignedStaffName)</strong></div>
                <div class="small text-secondary">Hẹn giờ giao: <strong>@(string.IsNullOrEmpty(Model.DeliveryTimeSlot) ? "Giờ hành chính" : Model.DeliveryTimeSlot)</strong></div>
            </div>
        </div>

        <!-- Items Table -->
        <table class="table table-bordered align-middle mb-3">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th style="width: 40px;" class="text-center">#</th>
                    <th>Tên Sản Phẩm &amp; Phân Loại</th>
                    <th>Mã SKU</th>
                    <th class="text-center" style="width: 60px;">SL</th>
                    <th class="text-end" style="width: 120px;">Đơn Giá</th>
                    <th class="text-end" style="width: 130px;">Thành Tiền</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 1; }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-center small">@(idx++)</td>
                        <td>
                            <div class="fw-semibold text-dark">@item.ProductName</div>
                            <div class="text-secondary small">Biến thể: @item.VariantName | Bảo hành: @item.WarrantyMonths Tháng</div>
                        </td>
                        <td class="font-monospace small">@item.VariantSku</td>
                        <td class="text-center font-monospace fw-bold">@item.Quantity</td>
                        <td class="text-end font-monospace">@item.UnitPrice.ToString("N0") đ</td>
                        <td class="text-end font-monospace fw-bold">@item.TotalPrice.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Totals Calculation -->
        <div class="row justify-content-end mb-4">
            <div class="col-6">
                <table class="table table-sm table-borderless mb-0">
                    <tr>
                        <td class="text-secondary small">Tạm tính tiền hàng:</td>
                        <td class="text-end font-monospace fw-semibold">@Model.Subtotal.ToString("N0") đ</td>
                    </tr>
                    <tr>
                        <td class="text-secondary small">Phí vận chuyển giao hàng:</td>
                        <td class="text-end font-monospace">@Model.ShippingFee.ToString("N0") đ</td>
                    </tr>
                    @if (Model.OrderDiscountAmount > 0)
                    {
                        <tr>
                            <td class="text-success small">Khuyến mãi voucher (@Model.AppliedOrderCouponCode):</td>
                            <td class="text-end font-monospace text-success">-@Model.OrderDiscountAmount.ToString("N0") đ</td>
                        </tr>
                    }
                    <tr class="border-top">
                        <td class="fw-bold fs-6">TỔNG THANH TOÁN:</td>
                        <td class="text-end font-monospace fw-bold fs-5 text-danger">@Model.TotalAmount.ToString("N0") đ</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Notes & Payment -->
        <div class="border-top pt-2 mb-4">
            <div class="small">Phương thức thanh toán: <strong>@Model.PaymentMethod</strong> (@(Model.PaymentStatus == PaymentStatus.Completed ? "Đã thanh toán đủ" : "Chưa thanh toán - Thu tiền khi nhận COD"))</div>
            @if (!string.IsNullOrEmpty(Model.CustomerNotes))
            {
                <div class="small text-muted mt-1">Ghi chú của khách: <em>@Model.CustomerNotes</em></div>
            }
        </div>

        <!-- Signatures -->
        <div class="row text-center pt-3 small text-secondary">
            <div class="col-4">
                <div class="fw-semibold text-dark">Khách Hàng Nhận Hàng</div>
                <div style="height: 50px;"></div>
                <div>(Ký &amp; ghi rõ họ tên)</div>
            </div>
            <div class="col-4">
                <div class="fw-semibold text-dark">Nhân Viên Bán Hàng</div>
                <div style="height: 50px;"></div>
                <div>@(string.IsNullOrEmpty(Model.AssignedStaffName) ? "Sales" : Model.AssignedStaffName)</div>
            </div>
            <div class="col-4">
                <div class="fw-semibold text-dark">Thủ Kho Đóng Gói</div>
                <div style="height: 50px;"></div>
                <div>(Ký xuất kho)</div>
            </div>
        </div>
    </div>

    <script>
        window.addEventListener('DOMContentLoaded', function() {
            JsBarcode("#invoiceBarcode", "@Model.OrderCode", {
                format: "CODE128",
                width: 1.6,
                height: 38,
                displayValue: false
            });
        });
    </script>
</body>
</html>
