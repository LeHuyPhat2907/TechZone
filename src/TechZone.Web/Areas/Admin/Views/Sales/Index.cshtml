                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-secondary">Khung Giờ Hẹn Giao</label>
                        <select name="deliveryTimeSlot" id="ship_timeslot" class="form-select">
                            <option value="Giờ hành chính (8h-17h)">Giờ hành chính (8h-17h)</option>
                            <option value="Buổi tối (18h-21h)">Buổi tối (18h-21h)</option>
                            <option value="Hỏa tốc 2 giờ">Hỏa tốc 2 giờ</option>
                            <option value="Cuối tuần (Thứ 7 / CN)">Cuối tuần (Thứ 7 / CN)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top px-4 py-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-info text-dark rounded-pill px-4 fw-semibold">Lưu Thông Tin</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 4. Modal Đổi Biến Thể / Thêm Phụ Kiện -->
<div class="modal fade" id="modifyItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <form method="post" action="@Url.Action("ModifyOrderItem", "Sales")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" id="mod_orderId" />
