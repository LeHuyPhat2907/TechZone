<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <form method="post" action="@Url.Action("CancelOrder", "Sales")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" id="cancel_orderId" />
                <div class="modal-header border-bottom px-4 pt-4 pb-3">
                    <h5 class="modal-title fw-bold text-danger">
                        <i class="bi bi-x-circle me-2"></i>Hủy Đơn Hàng
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Mã Đơn Hàng</label>
                        <input type="text" id="cancel_orderCode" class="form-control font-monospace bg-light" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Lý Do Hủy Đơn <span class="text-danger">*</span></label>
                        <select name="reason" class="form-select" required>
                            <option value="Khách hàng đổi ý, không có nhu cầu mua nữa">Khách hàng đổi ý, không có nhu cầu mua nữa</option>
                            <option value="Không thể liên lạc qua điện thoại nhiều lần">Không thể liên lạc qua điện thoại nhiều lần</option>
                            <option value="Phát hiện đơn hàng ảo / spam / địa chỉ giả">Phát hiện đơn hàng ảo / spam / địa chỉ giả</option>
                            <option value="Khách muốn đặt lại đơn hàng khác">Khách muốn đặt lại đơn hàng khác</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top px-4 py-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Quay Lại</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">Xác Nhận Hủy Đơn</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openCallModal(orderId, orderCode, customerName, phone) {
            document.getElementById('call_orderId').value = orderId;
            document.getElementById('call_customerInfo').innerText = orderCode + ' - ' + customerName + ' (' + phone + ')';
            new bootstrap.Modal(document.getElementById('callModal')).show();
        }

        function openAssignModal(orderId, orderCode) {
            document.getElementById('assign_orderId').value = orderId;
            document.getElementById('assign_orderCode').value = orderCode;
            new bootstrap.Modal(document.getElementById('assignModal')).show();
        }

        function onAssignStaffChanged(selectElem) {
            var selectedOption = selectElem.options[selectElem.selectedIndex];
            document.getElementById('assign_staffName').value = selectedOption.getAttribute('data-name');
        }

        function openShippingModal(orderId, name, phone, prov, dist, ward, detail, timeslot) {
            document.getElementById('ship_orderId').value = orderId;
            document.getElementById('ship_name').value = name;
            document.getElementById('ship_phone').value = phone;
            document.getElementById('ship_province').value = prov;
            document.getElementById('ship_district').value = dist;
            document.getElementById('ship_ward').value = ward;
            document.getElementById('ship_detail').value = detail;
            if (timeslot) {
                document.getElementById('ship_timeslot').value = timeslot;
            }
            new bootstrap.Modal(document.getElementById('shippingModal')).show();
        }

        function openModifyItemModal(orderId, orderCode, currentSku, currentProdName, qty) {
            document.getElementById('mod_orderId').value = orderId;
            document.getElementById('mod_oldSku').value = currentSku || '';
            document.getElementById('mod_currentDisplay').value = currentProdName + ' (' + (currentSku || '') + ')';
            document.getElementById('mod_qty').value = qty || 1;
            new bootstrap.Modal(document.getElementById('modifyItemModal')).show();
        }

        function openPromoModal(orderId, orderCode) {
            document.getElementById('promo_orderId').value = orderId;
            document.getElementById('promo_orderCode').value = orderCode;
            new bootstrap.Modal(document.getElementById('promoModal')).show();
        }

        function openInternalNoteModal(orderId, orderCode) {
            document.getElementById('note_orderId').value = orderId;
            document.getElementById('note_orderCode').value = orderCode;
            new bootstrap.Modal(document.getElementById('internalNoteModal')).show();
        }

        function openCancelModal(orderId, orderCode) {
            document.getElementById('cancel_orderId').value = orderId;
            document.getElementById('cancel_orderCode').value = orderCode;
            new bootstrap.Modal(document.getElementById('cancelModal')).show();
        }

        function onManualProductChanged(selectElem) {
            var selectedOption = selectElem.options[selectElem.selectedIndex];
            var sku = selectedOption.getAttribute('data-sku');
            if (sku) {
                document.getElementById('manual_skuInput').value = sku;
            }
        }
    </script>
}
