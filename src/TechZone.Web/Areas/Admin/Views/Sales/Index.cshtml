<!-- 1. Modal Gọi Xác Thực Cuộc Gọi Telesales -->
<div class="modal fade" id="callModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <form method="post" action="@Url.Action("UpdateCallStatus", "Sales")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" id="call_orderId" />
                <div class="modal-header border-bottom px-4 pt-4 pb-3">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-telephone-outbound text-success me-2"></i>Ghi Nhận Cuộc Gọi Xác Thực Đơn Hàng
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Khách Hàng</label>
                        <div class="fs-6 fw-bold text-dark" id="call_customerInfo"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Kết Quả Cuộc Gọi <span class="text-danger">*</span></label>
                        <select name="callStatus" class="form-select" required>
                            <option value="CallVerified">Đã gọi xác nhận thành công (Khách đồng ý nhận)</option>
                            <option value="Unreachable">Không liên lạc được / Máy bận</option>
                            <option value="Rescheduled">Khách hẹn gọi lại vào khung giờ khác</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Ghi Chú Cuộc Gọi</label>
                        <textarea name="note" class="form-control" rows="3" placeholder="Ghi nhận dặn dò của khách: giao trước 17h, gọi trước khi đến..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top px-4 py-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success text-white rounded-pill px-4 fw-semibold">Lưu Kết Quả</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 2. Modal Phân Công Sales Phụ Trách -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <form method="post" action="@Url.Action("AssignStaff", "Sales")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" id="assign_orderId" />
                <div class="modal-header border-bottom px-4 pt-4 pb-3">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-person-plus text-primary me-2"></i>Phân Công Chuyên Viên Xử Lý Đơn
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Mã Đơn Hàng</label>
                        <input type="text" id="assign_orderCode" class="form-control font-monospace bg-light" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Chuyên Viên Bán Hàng Phụ Trách <span class="text-danger">*</span></label>
                        <select name="staffId" class="form-select" required onchange="onAssignStaffChanged(this)">
                            @foreach (var staff in Model.SalesStaffList)
                            {
                                <option value="@staff.Id" data-name="@staff.FullName">
                                    @staff.FullName (@staff.Email)
