                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">Họ Tên</label>
                            <input type="text" name="receiverName" id="ship_name" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">Số Điện Thoại</label>
                            <input type="text" name="phoneNumber" id="ship_phone" class="form-control font-monospace" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
