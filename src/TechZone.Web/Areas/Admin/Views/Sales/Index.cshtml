                            <input type="text" name="province" id="ship_province" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">Quận / Huyện</label>
                            <input type="text" name="district" id="ship_district" class="form-control" required />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-secondary">Phường / Xã</label>
                        <input type="text" name="ward" id="ship_ward" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-secondary">Địa Chỉ Chi Tiết</label>
                        <input type="text" name="detailAddress" id="ship_detail" class="form-control" required />
