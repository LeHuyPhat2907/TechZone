                                    <th class="text-center">Tổng Nhập</th>
                                    <th class="text-center">Tồn Kho</th>
                                    <th class="text-center">Đã Xuất</th>
                                    <th class="text-end">Vốn Kho</th>
                                    <th class="text-end">Tỉ Lệ Xuất Bán</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.CategoryTurnovers.Any())
                                {
                                    <tr><td colspan="6" class="text-center py-3 text-muted">Chưa có dữ liệu tồn kho theo nhóm</td></tr>
                                }
                                else
                                {
                                    @foreach (var ct in Model.CategoryTurnovers)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">@ct.CategoryName</td>
                                            <td class="text-center font-monospace">@ct.TotalStock</td>
                                            <td class="text-center font-monospace text-primary">@ct.InStock</td>
                                            <td class="text-center font-monospace text-success">@ct.SoldUnits</td>
                                            <td class="text-end font-monospace">@ct.AssetValue.ToString("N0")₫</td>
                                            <td class="text-end">
                                                <span class="badge @(ct.TurnoverRate >= 50 ? "tz-badge-soft-success" : "tz-badge-soft-warning") rounded-pill font-monospace">
                                                    @ct.TurnoverRate%
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- STALE INVENTORY ALERT TABLE: report.inventory_turnover -->
