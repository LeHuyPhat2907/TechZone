                        <canvas id="inventoryAgingChart"></canvas>
                    </div>
                    <div class="row g-2 mt-3 pt-3 border-top text-center" style="font-size: 0.75rem;">
                        <div class="col-3">
                            <div class="p-2 bg-light rounded-3">
                                <div class="text-success fw-bold fs-6 font-monospace">@Model.AgingUnder30Days</div>
                                <span class="text-muted">&lt; 30 ngày (An toàn)</span>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="p-2 bg-light rounded-3">
                                <div class="text-primary fw-bold fs-6 font-monospace">@Model.Aging30To60Days</div>
                                <span class="text-muted">30-60 ngày (Bình thường)</span>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="p-2 bg-light rounded-3">
                                <div class="text-warning fw-bold fs-6 font-monospace">@Model.Aging60To90Days</div>
                                <span class="text-muted">61-90 ngày (Tồn chậm)</span>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="p-2 bg-light rounded-3">
                                <div class="text-danger fw-bold fs-6 font-monospace">@Model.AgingOver90Days</div>
                                <span class="text-muted">&gt; 90 ngày (Hàng om)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Category Turnover Table -->
            <div class="col-12 col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
