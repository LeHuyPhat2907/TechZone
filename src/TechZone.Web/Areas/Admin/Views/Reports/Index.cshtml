            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-secondary small fw-bold">
                            <th class="ps-3 py-3">Thiết Bị & Model</th>
                            <th>Mã IMEI / Serial</th>
                            <th>Vị Trí Kho / NCC</th>
                            <th class="text-center">Ngày Nhập Kho</th>
                            <th class="text-center">Số Ngày Tồn</th>
                            <th class="text-end">Vốn Giam (COGS)</th>
                            <th>Mức Nguy Cơ</th>
                            <th class="text-end pe-3">Khuyến Nghị Xử Lý</th>
                        </tr>
