@using System.Text.Json
@using TechZone.Domain.Enums
@model TechZone.Web.Areas.Admin.Models.ReportsViewModel
@{
    ViewData["Title"] = "Báo Cáo Tài Chính & Phân Tích Hiệu Suất";
}

<div class="container-fluid px-0">
    <!-- Header Page -->
    <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge tz-badge-soft-primary px-2.5 py-1 rounded-pill">
                    <i class="bi bi-graph-up-arrow me-1"></i>Báo Cáo & Tài Chính (Mục 1.7)
                </span>
                <span class="badge bg-dark text-light rounded-pill px-2.5 py-1">Enterprise Analytics & COGS</span>
            </div>
            <h2 class="h3 fw-bold text-dark mb-1">Phân Tích Doanh Thu, Lợi Nhuận & Vòng Quay Kho</h2>
            <p class="text-secondary small mb-0">Theo dõi dòng tiền, biên lợi nhuận sau giá vốn thiết bị, đối soát hàng om đọng và trích xuất dữ liệu RFC 4180 Excel/CSV.</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- Time Filter Range Quick Buttons -->
            <div class="btn-group btn-group-sm p-1 bg-white border rounded-pill shadow-2xs">
                <a href="@Url.Action("Index", "Reports", new { tab = Model.ActiveTab, range = "7d", granularity = Model.Granularity })" class="btn btn-sm rounded-pill px-3 @(Model.DateRange == "7d" ? "btn-primary" : "btn-light text-secondary")">7 ngày</a>
                <a href="@Url.Action("Index", "Reports", new { tab = Model.ActiveTab, range = "30d", granularity = Model.Granularity })" class="btn btn-sm rounded-pill px-3 @(Model.DateRange == "30d" ? "btn-primary" : "btn-light text-secondary")">30 ngày</a>
                <a href="@Url.Action("Index", "Reports", new { tab = Model.ActiveTab, range = "90d", granularity = Model.Granularity })" class="btn btn-sm rounded-pill px-3 @(Model.DateRange == "90d" ? "btn-primary" : "btn-light text-secondary")">Quý (90d)</a>
                <a href="@Url.Action("Index", "Reports", new { tab = Model.ActiveTab, range = "year", granularity = Model.Granularity })" class="btn btn-sm rounded-pill px-3 @(Model.DateRange == "year" ? "btn-primary" : "btn-light text-secondary")">Năm nay</a>
                <a href="@Url.Action("Index", "Reports", new { tab = Model.ActiveTab, range = "all", granularity = Model.Granularity })" class="btn btn-sm rounded-pill px-3 @(Model.DateRange == "all" ? "btn-primary" : "btn-light text-secondary")">Toàn bộ</a>
            </div>

            <!-- Custom Date Filter Modal Trigger -->
            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#customDateModal">
                <i class="bi bi-calendar3 me-1"></i>Tùy chọn ngày
            </button>

            <!-- Export CSV Action Direct -->
            <a href="@Url.Action("ExportFinancialData", "Reports", new { type = "orders", range = Model.DateRange, fromDate = Model.FromDate, toDate = Model.ToDate })" class="btn btn-success rounded-pill px-3.5 py-2 btn-sm d-flex align-items-center gap-1.5 shadow-sm fw-semibold">
                <i class="bi bi-file-earmark-excel-fill"></i>
                <span>Xuất Excel/CSV</span>
            </a>
        </div>
    </div>

    <!-- 4 Modules Tabs Navigation -->
    <ul class="nav nav-pills gap-2 mb-4 p-1.5 bg-white border rounded-4 shadow-2xs" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link rounded-3 px-3.5 py-2 fw-semibold @(Model.ActiveTab == "revenue" ? "active" : "text-secondary")" href="@Url.Action("Index", "Reports", new { tab = "revenue", range = Model.DateRange, granularity = Model.Granularity })">
                <i class="bi bi-currency-dollar me-1.5"></i>1. Biểu Đồ Doanh Thu
                <span class="badge bg-light text-dark ms-1 font-monospace" style="font-size: 0.7rem;">report.revenue</span>
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link rounded-3 px-3.5 py-2 fw-semibold @(Model.ActiveTab == "profit" ? "active" : "text-secondary")" href="@Url.Action("Index", "Reports", new { tab = "profit", range = Model.DateRange, granularity = Model.Granularity })">
                <i class="bi bi-piggy-bank me-1.5"></i>2. Lợi Nhuận Gộp & Biên Lãi
                <span class="badge bg-light text-dark ms-1 font-monospace" style="font-size: 0.7rem;">report.profit_margin</span>
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link rounded-3 px-3.5 py-2 fw-semibold @(Model.ActiveTab == "inventory" ? "active" : "text-secondary")" href="@Url.Action("Index", "Reports", new { tab = "inventory", range = Model.DateRange, granularity = Model.Granularity })">
                <i class="bi bi-box-seam me-1.5"></i>3. Vòng Quay Kho & Hàng Om
                @if (Model.Aging60To90Days + Model.AgingOver90Days > 0)
                {
                    <span class="badge bg-danger text-white rounded-pill ms-1">@(Model.Aging60To90Days + Model.AgingOver90Days)</span>
                }
                <span class="badge bg-light text-dark ms-1 font-monospace" style="font-size: 0.7rem;">report.inventory_turnover</span>
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link rounded-3 px-3.5 py-2 fw-semibold @(Model.ActiveTab == "export" ? "active" : "text-secondary")" href="@Url.Action("Index", "Reports", new { tab = "export", range = Model.DateRange, granularity = Model.Granularity })">
                <i class="bi bi-cloud-arrow-down me-1.5"></i>4. Xuất Báo Cáo Kế Toán
                <span class="badge bg-light text-dark ms-1 font-monospace" style="font-size: 0.7rem;">export.financial_data</span>
            </a>
        </li>
    </ul>

    <!-- TAB 1: REPORT.REVENUE -->
    @if (Model.ActiveTab == "revenue")
    {
        <!-- KPI Row -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-primary">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold">Tổng Doanh Thu Gộp (GMV)</span>
                        <div class="tz-admin-icon" style="background: rgba(2, 132, 199, 0.1); color: #0284c7; width: 34px; height: 34px;">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                    </div>
                    <div class="fs-4 fw-bold text-dark font-monospace">@Model.GrossRevenue.ToString("N0")₫</div>
                    <div class="d-flex align-items-center gap-1 text-muted" style="font-size: 0.72rem;">
                        <span>Từ <strong>@Model.TotalOrders</strong> đơn đặt hàng (@Model.CompletedOrders đơn hoàn tất)</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-success">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold">Doanh Thu Thuần (Net Sales)</span>
                        <div class="tz-admin-icon" style="background: rgba(16, 185, 129, 0.1); color: #10b981; width: 34px; height: 34px;">
                            <i class="bi bi-wallet2"></i>
                        </div>
                    </div>
                    <div class="fs-4 fw-bold text-success font-monospace">@Model.NetRevenue.ToString("N0")₫</div>
                    <span class="text-muted" style="font-size: 0.72rem;">Đã trừ <strong>@Model.TotalDiscounts.ToString("N0")₫</strong> tiền voucher/chiết khấu</span>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-warning">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold">Giá Trị Đơn Trung Bình (AOV)</span>
                        <div class="tz-admin-icon" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b; width: 34px; height: 34px;">
                            <i class="bi bi-cart-check"></i>
                        </div>
                    </div>
                    <div class="fs-4 fw-bold text-warning font-monospace">@Model.AverageOrderValue.ToString("N0")₫</div>
                    <span class="text-muted" style="font-size: 0.72rem;">Bình quân mỗi giỏ hàng thanh toán</span>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-info">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold">Tỷ Lệ Giao Thành Công</span>
                        <div class="tz-admin-icon" style="background: rgba(14, 165, 233, 0.1); color: #0ea5e9; width: 34px; height: 34px;">
                            <i class="bi bi-truck"></i>
                        </div>
                    </div>
                    <div class="fs-4 fw-bold text-info font-monospace">@Model.DeliverySuccessRate%</div>
                    <span class="text-muted" style="font-size: 0.72rem;">Tỷ lệ hủy: <strong>@Model.CancellationRate%</strong> (@Model.CancelledOrders đơn hủy)</span>
                </div>
            </div>
        </div>

        <!-- Main Chart Section: Daily, Weekly, Monthly, Quarterly -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                <div>
                    <h5 class="fw-bold text-dark mb-0">Biểu Đồ Doanh Thu & Số Lượng Đơn Đặt Hàng</h5>
                    <span class="text-muted small">Thời gian thực theo Ngày / Tuần / Tháng / Quý (Chu kỳ: @Model.DateRange)</span>
                </div>
                <!-- Granularity Switcher -->
                <div class="btn-group btn-group-sm p-1 bg-light border rounded-pill">
                    <a href="@Url.Action("Index", "Reports", new { tab = "revenue", range = Model.DateRange, granularity = "day" })" class="btn btn-sm rounded-pill px-3 @(Model.Granularity == "day" ? "btn-primary" : "btn-light text-secondary")">Theo Ngày</a>
                    <a href="@Url.Action("Index", "Reports", new { tab = "revenue", range = Model.DateRange, granularity = "week" })" class="btn btn-sm rounded-pill px-3 @(Model.Granularity == "week" ? "btn-primary" : "btn-light text-secondary")">Theo Tuần</a>
                    <a href="@Url.Action("Index", "Reports", new { tab = "revenue", range = Model.DateRange, granularity = "month" })" class="btn btn-sm rounded-pill px-3 @(Model.Granularity == "month" ? "btn-primary" : "btn-light text-secondary")">Theo Tháng</a>
                    <a href="@Url.Action("Index", "Reports", new { tab = "revenue", range = Model.DateRange, granularity = "quarter" })" class="btn btn-sm rounded-pill px-3 @(Model.Granularity == "quarter" ? "btn-primary" : "btn-light text-secondary")">Theo Quý</a>
                </div>
            </div>

            <!-- Canvas for Chart.js -->
            <div style="position: relative; height: 350px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <!-- Channel & Payment Breakdown Row -->
        <div class="row g-4 mb-4">
            <!-- Channel Breakdown -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-dark mb-0">Doanh Thu Theo Kênh Bán Hàng (Source Channel)</h6>
                        <span class="badge tz-badge-soft-primary rounded-pill">Đa kênh Omnichannel</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="text-secondary small fw-bold">
                                    <th>Kênh Bán</th>
                                    <th class="text-center">Số Đơn</th>
                                    <th class="text-end">Doanh Số</th>
                                    <th class="text-end">Tỷ Trọng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.ChannelBreakdowns.Any())
                                {
                                    <tr><td colspan="4" class="text-center py-3 text-muted">Chưa có dữ liệu kênh bán</td></tr>
                                }
                                else
                                {
                                    @foreach (var ch in Model.ChannelBreakdowns)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">
                                                <i class="bi bi-shop me-1.5 text-primary"></i>@ch.ChannelName
                                            </td>
                                            <td class="text-center font-monospace">@ch.OrderCount</td>
                                            <td class="text-end fw-bold font-monospace text-primary">@ch.Revenue.ToString("N0")₫</td>
                                            <td class="text-end">
                                                <span class="badge bg-light text-dark border font-monospace">@ch.Percentage%</span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Payment Method Breakdown -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-dark mb-0">Phương Thức Thanh Toán (Payment Methods)</h6>
                        <span class="badge tz-badge-soft-success rounded-pill">Dòng tiền thực thu</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="text-secondary small fw-bold">
                                    <th>Phương Thức</th>
                                    <th class="text-center">Số Đơn</th>
                                    <th class="text-end">Tổng Tiền</th>
                                    <th class="text-end">Tỷ Trọng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.PaymentBreakdowns.Any())
                                {
                                    <tr><td colspan="4" class="text-center py-3 text-muted">Chưa có dữ liệu thanh toán</td></tr>
                                }
                                else
                                {
                                    @foreach (var pm in Model.PaymentBreakdowns)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">
                                                <i class="bi bi-credit-card-2-front me-1.5 text-success"></i>@pm.MethodName
                                            </td>
                                            <td class="text-center font-monospace">@pm.OrderCount</td>
                                            <td class="text-end fw-bold font-monospace text-success">@pm.TotalAmount.ToString("N0")₫</td>
                                            <td class="text-end">
                                                <span class="badge bg-light text-dark border font-monospace">@pm.Percentage%</span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- TAB 2: REPORT.PROFIT_MARGIN -->
    @if (Model.ActiveTab == "profit")
    {
        <!-- KPI Row: Profit & COGS -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-secondary">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold">Giá Vốn Hàng Bán (COGS)</span>
                        <div class="tz-admin-icon" style="background: rgba(100, 116, 139, 0.1); color: #64748b; width: 34px; height: 34px;">
                            <i class="bi bi-receipt-cutoff"></i>
                        </div>
                    </div>
                    <div class="fs-4 fw-bold text-secondary font-monospace">@Model.TotalCostOfGoodsSold.ToString("N0")₫</div>
                    <span class="text-muted" style="font-size: 0.72rem;">Tổng giá nhập kho theo serial/lô hàng</span>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-success">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold">Lợi Nhuận Gộp (Gross Profit)</span>
                        <div class="tz-admin-icon" style="background: rgba(16, 185, 129, 0.1); color: #10b981; width: 34px; height: 34px;">
                            <i class="bi bi-cash-coin"></i>
                        </div>
                    </div>
                    <div class="fs-4 fw-bold text-success font-monospace">@Model.GrossProfit.ToString("N0")₫</div>
                    <div class="text-success small fw-semibold">Biên lãi gộp: @Model.ProfitMarginPercent%</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-danger">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold">Chi Phí Vận Hành Trợ Giá</span>
                        <div class="tz-admin-icon" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; width: 34px; height: 34px;">
                            <i class="bi bi-tag-fill"></i>
                        </div>
                    </div>
                    <div class="fs-4 fw-bold text-danger font-monospace">@((Model.TotalOrderVouchers + Model.TotalShippingSubsidy).ToString("N0"))₫</div>
                    <span class="text-muted" style="font-size: 0.72rem;">Voucher: @Model.TotalOrderVouchers.ToString("N0")₫ | Bù ship: @Model.TotalShippingSubsidy.ToString("N0")₫</span>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-primary">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold">Lợi Nhuận Vận Hành Ròng</span>
                        <div class="tz-admin-icon" style="background: rgba(2, 132, 199, 0.1); color: #0284c7; width: 34px; height: 34px;">
                            <i class="bi bi-trophy-fill"></i>
                        </div>
                    </div>
                    <div class="fs-4 fw-bold text-primary font-monospace">@Model.EstimatedOperatingProfit.ToString("N0")₫</div>
                    <div class="text-primary small fw-semibold">Biên lãi ròng: @Model.OperatingProfitMarginPercent%</div>
                </div>
            </div>
        </div>

        <!-- Profit Breakdown Structure & Chart -->
        <div class="row g-4 mb-4">
            <!-- Cost Structure Doughnut Chart -->
            <div class="col-12 col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-dark mb-0">Cơ Cấu Dòng Tiền & Chi Phí (Cost Breakdown)</h6>
                        <span class="badge bg-light text-secondary border font-monospace">COGS vs Margin</span>
                    </div>
                    <div style="position: relative; height: 260px;">
                        <canvas id="marginStructureChart"></canvas>
                    </div>
                    <div class="mt-3 pt-3 border-top small">
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-secondary"><i class="bi bi-circle-fill text-secondary me-1.5" style="font-size: 0.6rem;"></i>Giá vốn nhập kho (COGS):</span>
                            <strong class="font-monospace">@Model.TotalCostOfGoodsSold.ToString("N0")₫</strong>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-danger"><i class="bi bi-circle-fill text-danger me-1.5" style="font-size: 0.6rem;"></i>Trợ giá Voucher & Bù Ship:</span>
                            <strong class="font-monospace text-danger">@((Model.TotalOrderVouchers + Model.TotalShippingSubsidy).ToString("N0"))₫</strong>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-success"><i class="bi bi-circle-fill text-success me-1.5" style="font-size: 0.6rem;"></i>Lợi nhuận ròng giữ lại:</span>
                            <strong class="font-monospace text-success">@Model.EstimatedOperatingProfit.ToString("N0")₫</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Category Profitability -->
            <div class="col-12 col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-dark mb-0">Hiệu Suất & Biên Lãi Theo Danh Mục Sản Phẩm</h6>
                        <span class="badge tz-badge-soft-success rounded-pill">Category Profitability</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="text-secondary small fw-bold">
                                    <th>Danh Mục</th>
                                    <th class="text-center">Số Lượng Bán</th>
                                    <th class="text-end">Doanh Số</th>
                                    <th class="text-end">Giá Vốn</th>
                                    <th class="text-end">Lợi Nhuận Gộp</th>
                                    <th class="text-end">Biên Lãi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.CategoryProfits.Any())
                                {
                                    <tr><td colspan="6" class="text-center py-3 text-muted">Chưa có giao dịch danh mục</td></tr>
                                }
                                else
                                {
                                    @foreach (var cp in Model.CategoryProfits)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">@cp.CategoryName</td>
                                            <td class="text-center font-monospace">@cp.UnitsSold</td>
                                            <td class="text-end font-monospace">@cp.Revenue.ToString("N0")₫</td>
                                            <td class="text-end font-monospace text-secondary">@cp.CostOfGoodsSold.ToString("N0")₫</td>
                                            <td class="text-end font-monospace text-success fw-bold">+@cp.GrossProfit.ToString("N0")₫</td>
                                            <td class="text-end">
                                                <span class="badge @(cp.MarginPercent >= 20 ? "tz-badge-soft-success" : (cp.MarginPercent >= 10 ? "tz-badge-soft-primary" : "tz-badge-soft-warning")) rounded-pill font-monospace">
                                                    @cp.MarginPercent%
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Profit Generating Products Table -->
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <div>
