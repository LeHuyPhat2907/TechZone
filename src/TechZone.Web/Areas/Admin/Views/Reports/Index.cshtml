                            <tr>
                                <td colspan="8" class="text-center py-4 text-success fw-semibold">
                                    <i class="bi bi-check-circle-fill me-1.5"></i>Kho hàng hoàn hảo! Không có thiết bị nào bị tồn đọng trên 60 ngày.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var stale in Model.StaleInventoryItems)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="fw-bold text-dark">@stale.ProductName</div>
                                        <span class="text-muted small font-monospace">SKU: @(string.IsNullOrWhiteSpace(stale.VariantSku) ? "STANDARD" : stale.VariantSku)</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark font-monospace border">@stale.SerialNumber</span>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-secondary">@stale.WarehouseLocation</div>
                                        <span class="text-muted" style="font-size: 0.72rem;">@stale.SupplierName</span>
                                    </td>
                                    <td class="text-center small font-monospace">
                                        @stale.ReceivedDate.ToLocalTime().ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(stale.AgingDays > 90 ? "bg-danger" : "bg-warning text-dark") rounded-pill font-monospace px-2.5 py-1">
                                            @stale.AgingDays ngày
                                        </span>
                                    </td>
                                    <td class="text-end font-monospace fw-bold text-danger">
                                        @stale.CostPrice.ToString("N0")₫
                                    </td>
                                    <td>
                                        @if (stale.AlertSeverity == "Critical")
                                        {
                                            <span class="badge tz-badge-soft-danger rounded-pill px-2.5 py-1">
                                                <i class="bi bi-fire me-1"></i>Hàng Om &gt;90d
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge tz-badge-soft-warning rounded-pill px-2.5 py-1">
                                                <i class="bi bi-clock-history me-1"></i>Tồn Chậm 60-90d
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <span class="text-secondary small">@stale.Recommendation</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

