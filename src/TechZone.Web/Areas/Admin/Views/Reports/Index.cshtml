            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold text-dark mb-0">Nhật Ký Kiểm Toán Xuất Dữ Liệu Tài Chính (Export Audit Trail)</h6>
                    <span class="text-muted small">Lịch sử tải báo cáo của Kế toán &amp; Ban quản trị để giám sát an toàn thông tin</span>
                </div>
                <span class="badge bg-light text-secondary border font-monospace">audit.finance</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-secondary small fw-bold">
                            <th class="ps-3 py-3">Thời Gian</th>
                            <th>Tài Khoản Thực Hiện</th>
                            <th>Hành Động &amp; Module</th>
                            <th class="pe-3">Chi Tiết Báo Cáo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentExportAuditLogs.Any())
                        {
                            <tr><td colspan="4" class="text-center py-4 text-muted">Chưa có nhật ký trích xuất tài chính gần đây.</td></tr>
                        }
                        else
                        {
                            @foreach (var log in Model.RecentExportAuditLogs)
                            {
                                <tr>
                                    <td class="ps-3 font-monospace small">@log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@log.UserEmail</div>
                                    </td>
                                    <td>
                                        <span class="badge tz-badge-soft-primary font-monospace">@log.Action</span>
                                        <span class="badge bg-light text-secondary border">@log.Module</span>
                                    </td>
                                    <td class="pe-3 small text-secondary">
                                        @log.Details
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Recent Transactions Table (Always accessible under active tab for audit) -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
            <div>
                <h6 class="fw-bold text-dark mb-0">Sổ Giao Dịch & Hóa Đơn Bán Lẻ Gần Đây</h6>
                <span class="text-muted small">Chi tiết các đơn hàng bán lẻ đối soát thanh toán trực tiếp</span>
            </div>
            <a href="@Url.Action("ExportFinancialData", "Reports", new { type = "orders", range = Model.DateRange })" class="btn btn-xs btn-outline-success rounded-pill px-3">
                <i class="bi bi-download me-1"></i>Tải Toàn Bộ Sổ Giao Dịch
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="text-secondary small fw-bold text-uppercase" style="letter-spacing: 0.04em;">
                        <th class="ps-3 py-3">Mã Đơn / Thời Gian</th>
                        <th>Khách Hàng & Liên Hệ</th>
                        <th>Kênh Bán</th>
                        <th>SL Thiết Bị</th>
                        <th>Tạm Tính</th>
                        <th>Giảm Giá</th>
                        <th>Phí Ship</th>
                        <th>Tổng Thanh Toán</th>
                        <th>Phương Thức & TT</th>
                        <th class="text-end pe-3">Trạng Thái Đơn</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentTransactions.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">Chưa có giao dịch phát sinh trong giai đoạn này.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var o in Model.RecentTransactions)
                        {
                            <tr>
                                <td class="ps-3">
                                    <a href="/Admin/Order/Detail/@o.Id" class="fw-bold font-monospace text-primary text-decoration-none">@o.OrderCode</a>
                                    <div class="text-muted" style="font-size: 0.72rem;">@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@o.CustomerName</div>
                                    <span class="text-muted small">@o.CustomerPhone</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(string.IsNullOrWhiteSpace(o.SourceChannel) ? "Website" : o.SourceChannel)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace">@o.Items.Sum(i => i.Quantity) chiếc</span>
                                </td>
                                <td>
                                    <span class="text-dark small">@o.Subtotal.ToString("N0")₫</span>
                                </td>
                                <td>
                                    @{
                                        var totalDiscount = o.OrderDiscountAmount + o.ShippingDiscountAmount;
                                    }
                                    @if (totalDiscount > 0)
                                    {
                                        <span class="text-danger small font-monospace">-@totalDiscount.ToString("N0")₫</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">0₫</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-secondary small">@o.ShippingFee.ToString("N0")₫</span>
                                </td>
                                <td>
                                    <strong class="text-primary font-monospace">@o.TotalAmount.ToString("N0")₫</strong>
                                </td>
                                <td>
                                    <div class="small fw-semibold text-dark">@o.PaymentMethod</div>
                                    <span class="badge @(o.PaymentStatus == PaymentStatus.Completed ? "tz-badge-soft-success" : "tz-badge-soft-warning")" style="font-size: 0.68rem;">
                                        @(o.PaymentStatus == PaymentStatus.Completed ? "Đã TT" : "Chờ TT")
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    @{
                                        var stBadge = o.OrderStatus switch
                                        {
                                            OrderStatus.Delivered => "tz-badge-soft-success",
                                            OrderStatus.Shipping => "tz-badge-soft-primary",
                                            OrderStatus.Confirmed => "tz-badge-soft-primary",
                                            OrderStatus.Pending => "tz-badge-soft-warning",
                                            OrderStatus.Cancelled => "tz-badge-soft-danger",
                                            _ => "tz-badge-soft-secondary"
                                        };
                                        var stText = o.OrderStatus switch
                                        {
                                            OrderStatus.Delivered => "Hoàn tất",
                                            OrderStatus.Shipping => "Đang giao",
                                            OrderStatus.Confirmed => "Đã duyệt",
                                            OrderStatus.Pending => "Chờ xử lý",
                                            OrderStatus.Cancelled => "Đã hủy",
                                            _ => o.OrderStatus.ToString()
                                        };
                                    }
                                    <span class="badge @stBadge rounded-pill px-2.5 py-1">@stText</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Custom Date Filter -->
<div class="modal fade" id="customDateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="bi bi-calendar3 me-2 text-primary"></i>Chọn Khoảng Thời Gian Tùy Chỉnh
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="get" action="@Url.Action("Index", "Reports")">
                <div class="modal-body">
                    <input type="hidden" name="tab" value="@Model.ActiveTab" />
                    <input type="hidden" name="range" value="custom" />
                    <input type="hidden" name="granularity" value="@Model.Granularity" />

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Từ Ngày</label>
                        <input type="date" name="fromDate" class="form-control rounded-3" value="@(Model.FromDate?.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.AddDays(-30).ToString("yyyy-MM-dd"))" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Đến Ngày</label>
                        <input type="date" name="toDate" class="form-control rounded-3" value="@(Model.ToDate?.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.ToString("yyyy-MM-dd"))" required />
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">Áp Dụng Lọc</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Include Chart.js from CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. REVENUE CHART (Tab 1: report.revenue)
            var revenueCanvas = document.getElementById("revenueChart");
            if (revenueCanvas) {
                var chartDataPoints = @Html.Raw(JsonSerializer.Serialize(Model.ChartPoints));
                var labels = chartDataPoints.map(p => p.PeriodLabel);
                var grossData = chartDataPoints.map(p => p.GrossRevenue);
                var netData = chartDataPoints.map(p => p.NetRevenue);
                var profitData = chartDataPoints.map(p => p.Profit);
                var ordersData = chartDataPoints.map(p => p.OrderCount);

                var ctx = revenueCanvas.getContext("2d");
                new Chart(ctx, {
                    type: "bar",
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                type: "line",
                                label: "Số lượng đơn đặt",
                                data: ordersData,
                                yAxisID: "y1",
                                borderColor: "#f59e0b",
                                backgroundColor: "rgba(245, 158, 11, 0.2)",
                                borderWidth: 2,
                                pointRadius: 4,
                                pointHoverRadius: 6,
                                fill: false,
                                tension: 0.3
                            },
                            {
                                type: "bar",
                                label: "Doanh thu gộp (VND)",
                                data: grossData,
                                yAxisID: "y",
                                backgroundColor: "rgba(2, 132, 199, 0.8)",
                                borderColor: "#0284c7",
                                borderWidth: 1,
                                borderRadius: 6
                            },
                            {
                                type: "line",
                                label: "Lợi nhuận gộp (VND)",
                                data: profitData,
                                yAxisID: "y",
                                borderColor: "#10b981",
                                backgroundColor: "rgba(16, 185, 129, 0.15)",
                                borderWidth: 2.5,
                                pointRadius: 4,
                                pointHoverRadius: 6,
                                fill: true,
                                tension: 0.3
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: "index",
                            intersect: false
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { font: { family: "system-ui", size: 12 } }
                            },
                            y: {
                                type: "linear",
                                display: true,
                                position: "left",
                                grid: { color: "#f1f5f9" },
                                ticks: {
                                    callback: function(value) {
                                        if (value >= 1000000) return (value / 1000000).toFixed(0) + " tr";
                                        if (value >= 1000) return (value / 1000).toFixed(0) + " k";
                                        return value;
                                    }
                                }
                            },
                            y1: {
                                type: "linear",
                                display: true,
                                position: "right",
                                grid: { drawOnChartArea: false },
                                ticks: {
                                    stepSize: 1,
                                    callback: function(value) { return value + " đơn"; }
                                }
                            }
                        },
                        plugins: {
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        var label = context.dataset.label || "";
                                        var val = context.raw;
                                        if (context.dataset.yAxisID === "y") {
                                            return label + ": " + new Intl.NumberFormat("vi-VN", { style: "currency", currency: "VND" }).format(val);
                                        }
                                        return label + ": " + val + " đơn";
                                    }
                                }
                            },
                            legend: {
                                position: "top",
                                labels: { font: { family: "system-ui", size: 12, weight: "bold" } }
                            }
                        }
                    }
                });
            }

            // 2. PROFIT MARGIN DOUGHNUT CHART (Tab 2: report.profit_margin)
            var marginCanvas = document.getElementById("marginStructureChart");
            if (marginCanvas) {
                var cogs = @Model.TotalCostOfGoodsSold;
                var vouchers = @(Model.TotalOrderVouchers + Model.TotalShippingSubsidy);
                var operatingProfit = @Model.EstimatedOperatingProfit;

                var ctxMargin = marginCanvas.getContext("2d");
                new Chart(ctxMargin, {
                    type: "doughnut",
                    data: {
                        labels: ["Giá vốn hàng bán (COGS)", "Trợ giá Voucher & Bù ship", "Lợi nhuận ròng giữ lại"],
                        datasets: [{
                            data: [cogs, vouchers, operatingProfit],
                            backgroundColor: ["#64748b", "#ef4444", "#10b981"],
                            borderWidth: 2,
                            borderColor: "#ffffff"
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: "bottom",
                                labels: { font: { family: "system-ui", size: 11 } }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        var val = context.raw;
                                        return context.label + ": " + new Intl.NumberFormat("vi-VN", { style: "currency", currency: "VND" }).format(val);
                                    }
                                }
                            }
                        },
                        cutout: "65%"
                    }
                });
            }

            // 3. INVENTORY AGING CHART (Tab 3: report.inventory_turnover)
            var agingCanvas = document.getElementById("inventoryAgingChart");
            if (agingCanvas) {
                var u30 = @Model.AgingUnder30Days;
                var a30to60 = @Model.Aging30To60Days;
                var a60to90 = @Model.Aging60To90Days;
                var o90 = @Model.AgingOver90Days;

                var ctxAging = agingCanvas.getContext("2d");
                new Chart(ctxAging, {
                    type: "bar",
                    data: {
                        labels: ["< 30 ngày (An toàn)", "30-60 ngày (Bình thường)", "61-90 ngày (Tồn chậm)", "> 90 ngày (Hàng om)"],
                        datasets: [{
                            label: "Số lượng thiết bị",
                            data: [u30, a30to60, a60to90, o90],
                            backgroundColor: ["#10b981", "#0284c7", "#f59e0b", "#ef4444"],
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        indexAxis: "y",
                        scales: {
                            x: {
                                grid: { color: "#f1f5f9" },
                                ticks: { stepSize: 1 }
                            },
                            y: {
                                grid: { display: false },
                                ticks: { font: { family: "system-ui", size: 12, weight: "bold" } }
                            }
                        },
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }
        });
    </script>
}
