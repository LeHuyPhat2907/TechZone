                        {
                            <tr><td colspan="6" class="text-center py-4 text-muted">Chưa có dữ liệu sản phẩm phát sinh doanh thu</td></tr>
                        }
                        else
                        {
                            @for (int i = 0; i < Model.TopProfitProducts.Count; i++)
                            {
                                var tp = Model.TopProfitProducts[i];
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge rounded-circle @(i < 3 ? "bg-warning text-dark" : "bg-light text-secondary border")" style="width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem;">
                                                @(i + 1)
                                            </span>
                                            <div>
                                                <div class="fw-bold text-dark">@tp.ProductName</div>
                                                <span class="text-muted small font-monospace">SKU: @(string.IsNullOrWhiteSpace(tp.VariantSku) ? "STANDARD" : tp.VariantSku)</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center font-monospace">@tp.UnitsSold chiếc</td>
                                    <td class="text-end font-monospace">@tp.Revenue.ToString("N0")₫</td>
                                    <td class="text-end font-monospace text-secondary">@tp.CostOfGoodsSold.ToString("N0")₫</td>
                                    <td class="text-end font-monospace text-success fw-bold">+@tp.GrossProfit.ToString("N0")₫</td>
                                    <td class="text-end pe-3">
                                        <span class="badge @(tp.MarginPercent >= 20 ? "tz-badge-soft-success" : "tz-badge-soft-primary") rounded-pill px-2.5 py-1 font-monospace">
                                            @tp.MarginPercent%
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- TAB 3: REPORT.INVENTORY_TURNOVER -->
