<div class="modal fade" id="saveSeoCampaignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form asp-action="SaveSeoCampaign" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="seoCampaignId" />
                <div class="modal-header border-bottom py-3 px-4">
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="seoModalHeaderTitle">Cấu Hình Meta SEO & Landing Page Sự Kiện</h5>
                        <span class="text-muted small">Tối ưu thẻ tìm kiếm Google, OpenGraph và trang đích sự kiện khuyến mãi</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12 col-md-7">
                            <label class="form-label fw-semibold small text-dark">Tiêu đề chiến dịch <span class="text-danger">*</span></label>
                            <input type="text" name="Title" id="seoCampaignTitle" class="form-control rounded-3" placeholder="VD: Đại Tiệc Apple Black Friday 2026" required />
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label fw-semibold small text-dark">Đường dẫn thân thiện (Slug) <span class="text-danger">*</span></label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-muted">/khuyen-mai/</span>
                                <input type="text" name="EventSlug" id="seoCampaignSlug" class="form-control rounded-end-3" placeholder="dai-tiec-apple-2026" required />
                            </div>
                        </div>
                        <div class="col-12 col-md-7">
                            <label class="form-label fw-semibold small text-dark">Ảnh đại diện Banner sự kiện (Desktop / OG Image)</label>
                            <input type="text" name="ImageUrl" id="seoCampaignImageUrl" class="form-control rounded-3" placeholder="https://... hoặc /images/banners/event.jpg" />
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label fw-semibold small text-dark">Canonical URL</label>
                            <input type="text" name="CanonicalUrl" id="seoCampaignCanonical" class="form-control rounded-3" placeholder="https://techzone.vn/khuyen-mai/..." />
