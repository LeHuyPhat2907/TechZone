                        <div class="col-12">
                            <label class="form-label fw-semibold small text-dark">Thẻ Meta Title (Tối ưu Google SERP)</label>
                            <input type="text" name="MetaTitle" id="seoCampaignMetaTitle" class="form-control rounded-3" placeholder="VD: Đại Tiệc Apple 2026 - Giảm sốc iPhone, iPad, MacBook tại TechZone" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small text-dark">Thẻ Meta Description (Mô tả hiển thị Google)</label>
                            <textarea name="MetaDescription" id="seoCampaignMetaDesc" class="form-control rounded-3" rows="2" placeholder="VD: Sự kiện siêu ưu đãi hệ sinh thái Apple chính hãng VN/A lớn nhất năm tại TechZone. Giảm trực tiếp tới 4 triệu..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small text-dark">Thẻ Meta Keywords (Từ khóa cách nhau bằng dấu phẩy)</label>
                            <input type="text" name="MetaKeywords" id="seoCampaignKeywords" class="form-control rounded-3" placeholder="VD: apple, iphone 16, macbook, black friday, khuyen mai, voucher" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small text-dark">Nội dung / Thể lệ Landing Page Sự Kiện (Markdown / HTML)</label>
                            <textarea name="HtmlContent" id="seoCampaignHtml" class="form-control font-monospace rounded-3" rows="4" placeholder="Nhập thể lệ chương trình, điều kiện áp dụng, danh sách mã voucher quà tặng..."></textarea>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small text-dark">Ngày bắt đầu chiến dịch</label>
                            <input type="datetime-local" name="StartDate" id="seoCampaignStartDate" class="form-control rounded-3" />
