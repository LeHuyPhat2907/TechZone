                            <input type="text" name="Title" id="editCouponTitle" class="form-control rounded-3" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small text-dark">Phạm vi áp dụng</label>
                            <select name="Scope" id="editCouponScope" class="form-select rounded-3">
                                <option value="0">Giảm trên đơn hàng (Order)</option>
                                <option value="1">Giảm phí ship (Shipping)</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small text-dark">Mô tả thể lệ</label>
                            <input type="text" name="Description" id="editCouponDesc" class="form-control rounded-3" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold small text-dark">Loại giảm</label>
                            <select name="DiscountType" id="editCouponDiscountType" class="form-select rounded-3">
                                <option value="1">Số tiền cố định (VNĐ)</option>
                                <option value="0">Tỷ lệ phần trăm (%)</option>
                            </select>
