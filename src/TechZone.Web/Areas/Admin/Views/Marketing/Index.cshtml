                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small text-dark">Ngày kết thúc chiến dịch</label>
                            <input type="datetime-local" name="EndDate" id="seoCampaignEndDate" class="form-control rounded-3" />
                        </div>
                        <div class="col-12">
