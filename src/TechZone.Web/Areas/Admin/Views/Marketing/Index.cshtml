                                <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="seoCampaignIsActive" checked>
                                <label class="form-check-label fw-semibold small text-success" for="seoCampaignIsActive">Kích hoạt hiển thị sự kiện trên Google & Landing Page</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top py-3 px-4">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                        <i class="bi bi-cloud-arrow-up me-1"></i>Lưu Cấu Hình SEO & Landing Page
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Bind Edit Coupon Modal
        document.querySelectorAll('.btn-edit-coupon').forEach(btn => {
            btn.addEventListener('click', function () {
                const c = JSON.parse(this.getAttribute('data-coupon'));
                document.getElementById('editCouponId').value = c.Id;
                document.getElementById('editCouponCodeHeader').innerText = `Mã: ${c.Code}`;
                document.getElementById('editCouponTitle').value = c.Title || '';
                document.getElementById('editCouponDesc').value = c.Description || '';
                document.getElementById('editCouponScope').value = c.Scope;
                document.getElementById('editCouponDiscountType').value = c.DiscountType;
                document.getElementById('editCouponDiscountValue').value = c.DiscountValue;
                document.getElementById('editCouponMaxDiscount').value = c.MaxDiscountAmount || '';
                document.getElementById('editCouponMinOrder').value = c.MinOrderValue || 0;
                document.getElementById('editCouponUsageLimit').value = c.UsageLimit || 100;
                document.getElementById('editCouponLimitUser').value = c.UsageLimitPerUser || 1;
                document.getElementById('editCouponStartDate').value = c.StartDate;
                document.getElementById('editCouponEndDate').value = c.EndDate;
                document.getElementById('editIsFlashSale').checked = c.IsFlashSale || false;
                document.getElementById('editFlashSaleSlot').value = c.FlashSaleSlot || '';
                document.getElementById('editIsCombo').checked = c.IsComboPromotion || false;
                document.getElementById('editApplicableCat').value = c.ApplicableCategory || '';
                document.getElementById('editMinQty').value = c.MinItemQuantity || 1;
                document.getElementById('editCouponIsActive').checked = c.IsActive;

                const editModal = new bootstrap.Modal(document.getElementById('editCouponModal'));
                editModal.show();
            });
        });

        // Bind Edit Banner Modal
        document.querySelectorAll('.btn-edit-banner').forEach(btn => {
            btn.addEventListener('click', function () {
                const b = JSON.parse(this.getAttribute('data-banner'));
                document.getElementById('editBannerId').value = b.Id;
                document.getElementById('editBannerTitle').value = b.Title || '';
                document.getElementById('editBannerImageUrl').value = b.ImageUrl || '';
                document.getElementById('editBannerMobileUrl').value = b.MobileImageUrl || '';
                document.getElementById('editBannerLinkUrl').value = b.LinkUrl || '';
                document.getElementById('editBannerPosition').value = b.Position;
                document.getElementById('editBannerDisplayOrder').value = b.DisplayOrder || 1;
                document.getElementById('editBannerStartDate').value = b.StartDate;
                document.getElementById('editBannerEndDate').value = b.EndDate;
                document.getElementById('editBannerIsActive').checked = b.IsActive;

                const editModal = new bootstrap.Modal(document.getElementById('editBannerModal'));
                editModal.show();
            });
        });

        // Bind Edit SEO Campaign Modal
        document.querySelectorAll('.btn-edit-seo').forEach(btn => {
            btn.addEventListener('click', function () {
                const s = JSON.parse(this.getAttribute('data-seo'));
                document.getElementById('seoCampaignId').value = s.Id;
                document.getElementById('seoModalHeaderTitle').innerText = `Chỉnh Sửa Chiến Dịch: ${s.Title}`;
                document.getElementById('seoCampaignTitle').value = s.Title || '';
                document.getElementById('seoCampaignSlug').value = s.EventSlug || '';
                document.getElementById('seoCampaignImageUrl').value = s.ImageUrl || '';
                document.getElementById('seoCampaignCanonical').value = s.CanonicalUrl || '';
                document.getElementById('seoCampaignMetaTitle').value = s.MetaTitle || '';
                document.getElementById('seoCampaignMetaDesc').value = s.MetaDescription || '';
                document.getElementById('seoCampaignKeywords').value = s.MetaKeywords || '';
                document.getElementById('seoCampaignHtml').value = s.HtmlContent || '';
                document.getElementById('seoCampaignStartDate').value = s.StartDate;
                document.getElementById('seoCampaignEndDate').value = s.EndDate;
                document.getElementById('seoCampaignIsActive').checked = s.IsActive;

                const seoModal = new bootstrap.Modal(document.getElementById('saveSeoCampaignModal'));
                seoModal.show();
            });
        });
    </script>
}
