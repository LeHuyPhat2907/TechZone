<!-- MODAL: Update Ticket Progress & Cost -->
<div class="modal fade" id="progressModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form asp-action="UpdateTicketProgress" method="post" class="modal-content rounded-4 border-0 shadow">
            @Html.AntiForgeryToken()
            <input type="hidden" name="RmaId" id="progressRmaId" />
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-tools text-primary me-2"></i>Cập Nhật Tiến Độ & Chi Phí Sửa Chữa <span id="progressRmaCode" class="text-primary font-monospace"></span></h5>
