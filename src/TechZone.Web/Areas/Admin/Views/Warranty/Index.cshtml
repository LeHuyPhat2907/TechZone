                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Phương án xử lý:</label>
                        <select name="ResolutionType" id="progressResolution" class="form-select form-select-sm">
                            <option value="FreeRepair">Sửa chữa / Thay linh kiện</option>
                            <option value="ExchangeNew">Đổi mới 1-1 sản phẩm tương đương</option>
                            <option value="Refund">Hoàn tiền lại cho khách</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Serial máy đổi mới (nếu đổi 1-1):</label>
                        <input name="ReplacementSerialNumber" class="form-control form-control-sm font-monospace" placeholder="S/N máy mới xuất từ kho" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Trạng thái thanh toán chi phí:</label>
                        <select name="PaymentStatus" id="progressPaymentStatus" class="form-select form-select-sm">
                            <option value="FreeUnderWarranty">Bảo hành 0₫ (TechZone chịu 100%)</option>
                            <option value="Unpaid">Chưa thanh toán (Chờ thu tiền khách)</option>
                            <option value="Paid">Đã thanh toán đủ</option>
                        </select>
                    </div>

                    <!-- Cost Configuration -->
                    <div class="col-12">
                        <div class="card border p-3 rounded-3 bg-light">
                            <h6 class="fw-bold text-dark mb-2">Chi Phí Thay Thế & Công Sửa Chữa</h6>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label small">Tiền linh kiện (₫):</label>
                                    <input type="number" name="PartsCost" id="progressPartsCost" class="form-control form-control-sm" value="0" oninput="calcProgressTotal()" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small">Tiền công thợ (₫):</label>
                                    <input type="number" name="LaborCost" id="progressLaborCost" class="form-control form-control-sm" value="0" oninput="calcProgressTotal()" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small">Giảm trừ ưu đãi (₫):</label>
                                    <input type="number" name="DiscountAmount" id="progressDiscount" class="form-control form-control-sm" value="0" oninput="calcProgressTotal()" />
                                </div>
                                <div class="col-12 mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                                    <div class="form-check form-switch m-0">
                                        <input class="form-check-input" type="checkbox" name="IsCustomerPaid" value="true" id="progressCustomerPaidCheck" onchange="onCustomerPaidToggle(this.checked)">
                                        <label class="form-check-label small fw-bold" for="progressCustomerPaidCheck">Sửa chữa tính phí (Khách hàng trả)</label>
                                    </div>
                                    <div>
                                        <span class="small text-muted me-2">Tổng thu khách:</span>
                                        <strong class="fs-5 text-danger" id="progressTotalDisplay">0₫</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-semibold">Ghi chú kỹ thuật viên / Báo cáo sửa chữa:</label>
                        <textarea name="TechnicianNotes" class="form-control form-control-sm" rows="3" placeholder="Đã thay panel OLED chính hãng, vệ sinh quỳ tím, test hiển thị đạt chuẩn 100%..."></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Lưu Cập Nhật Tiến Độ</button>
            </div>
        </form>
    </div>
</div>

