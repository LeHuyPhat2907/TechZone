<!-- MODAL: Printable Receipt Preview -->
<div class="modal fade" id="receiptModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-printer text-primary me-2"></i>Biên Nhận Tiếp Nhận Bảo Hành</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" id="receiptModalBody">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" onclick="window.print()">
                    <i class="bi bi-printer-fill me-1"></i>In Biên Nhận
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function openDispatchModal(rmaId, rmaCode, techName, estDate, priority) {
        document.getElementById('dispatchRmaId').value = rmaId;
        document.getElementById('dispatchRmaCode').innerText = '#' + rmaCode;
        if (techName) {
            document.getElementById('dispatchTechSelect').value = techName;
        }
        if (estDate) {
            document.getElementById('dispatchEstDate').value = estDate;
        }
        if (priority) {
            document.getElementById('dispatchPriority').value = priority;
        }
        new bootstrap.Modal(document.getElementById('dispatchModal')).show();
    }

    function openProgressModal(rmaId, rmaCode, status, resolution, partsCost, laborCost, discount, isPaid, payStatus) {
        document.getElementById('progressRmaId').value = rmaId;
        document.getElementById('progressRmaCode').innerText = '#' + rmaCode;
        document.getElementById('progressNewStatus').value = status;
        document.getElementById('progressResolution').value = resolution;
        document.getElementById('progressPartsCost').value = partsCost;
        document.getElementById('progressLaborCost').value = laborCost;
        document.getElementById('progressDiscount').value = discount;
        document.getElementById('progressCustomerPaidCheck').checked = isPaid === 'True' || isPaid === true;
        document.getElementById('progressPaymentStatus').value = payStatus || 'FreeUnderWarranty';
        calcProgressTotal();
        new bootstrap.Modal(document.getElementById('progressModal')).show();
    }

    function calcProgressTotal() {
        const parts = parseFloat(document.getElementById('progressPartsCost').value) || 0;
        const labor = parseFloat(document.getElementById('progressLaborCost').value) || 0;
        const discount = parseFloat(document.getElementById('progressDiscount').value) || 0;
        const total = Math.max(0, parts + labor - discount);
        document.getElementById('progressTotalDisplay').innerText = total.toLocaleString() + '₫';
    }

    function onCustomerPaidToggle(isChecked) {
        const paySelect = document.getElementById('progressPaymentStatus');
        if (!isChecked) {
            paySelect.value = 'FreeUnderWarranty';
        } else {
            paySelect.value = 'Unpaid';
        }
    }

    function openCreateRmaWithPrefill(orderCode, prodName, serial, custName, custPhone) {
        document.getElementById('rmaOrderCode').value = orderCode || '';
        document.getElementById('rmaProdName').value = prodName || '';
        document.getElementById('rmaSerial').value = serial || '';
        document.getElementById('rmaCustName').value = custName || '';
        document.getElementById('rmaCustPhone').value = custPhone || '';
        new bootstrap.Modal(document.getElementById('createRmaModal')).show();
    }

    function openPolicyCreateModal() {
        document.getElementById('policyId').value = '';
        document.getElementById('policyModalTitle').innerText = 'Thêm Chính Sách Bảo Hành Mới';
        document.getElementById('polCode').value = '';
        document.getElementById('polName').value = '';
        document.getElementById('polMonths').value = '12';
        document.getElementById('polDoa').value = '30';
        document.getElementById('polDeadPixel').value = '3';
        document.getElementById('polBattery').value = '80';
        document.getElementById('polTerms').value = '';
        document.getElementById('polExclusion').value = '';
    }

    function openPolicyEditModal(id, code, name, group, months, doa, deadPixel, battery, care, active, terms, exclusions) {
        document.getElementById('policyId').value = id;
        document.getElementById('policyModalTitle').innerText = 'Chỉnh Sửa Chính Sách #' + code;
        document.getElementById('polCode').value = code;
        document.getElementById('polName').value = name;
        document.getElementById('polGroup').value = group;
        document.getElementById('polMonths').value = months;
        document.getElementById('polDoa').value = doa;
        document.getElementById('polDeadPixel').value = deadPixel;
        document.getElementById('polBattery').value = battery;
        document.getElementById('polCareCheck').checked = care === 'True' || care === true;
        document.getElementById('polActiveCheck').checked = active === 'True' || active === true;
        document.getElementById('polTerms').value = terms;
        document.getElementById('polExclusion').value = exclusions;
        new bootstrap.Modal(document.getElementById('policyModal')).show();
    }

    function openClaimModal(warrantyId, serial) {
        document.getElementById('claimWarrantyId').value = warrantyId;
        document.getElementById('claimSerial').innerText = serial;
        new bootstrap.Modal(document.getElementById('claimModal')).show();
    }

    async function printRmaReceipt(rmaId) {
        const body = document.getElementById('receiptModalBody');
        body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>';
        new bootstrap.Modal(document.getElementById('receiptModal')).show();

        try {
            const resp = await fetch(`/Admin/Warranty/PrintReceipt?rmaId=${encodeURIComponent(rmaId)}`);
            const html = await resp.text();
            body.innerHTML = html;
        } catch (err) {
            body.innerHTML = '<div class="alert alert-danger m-3">Không thể tải biên nhận: ' + err.message + '</div>';
        }
    }
</script>
