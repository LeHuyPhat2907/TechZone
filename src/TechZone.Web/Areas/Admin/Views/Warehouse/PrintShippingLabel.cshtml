@using TechZone.Domain.Enums
@model TechZone.Domain.Entities.Order
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Phiếu Giao Hàng & Vận Đơn - @Model.OrderCode</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <style>
        @@media print {
            .no-print {
                display: none !important;
            }
            body {
                margin: 0;
                padding: 10mm;
            }
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: #0f172a;
            background: #f8fafc;
        }
        .shipping-label-card {
            width: 700px;
            margin: 20px auto;
            background: #ffffff;
            border: 2px solid #334155;
            padding: 24px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        }
        .dashed-bottom {
            border-bottom: 2px dashed #94a3b8;
        }
    </style>
</head>
<body class="p-4">
    <div class="text-center no-print mb-3">
        <button onclick="window.print()" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
            🖨️ In Vận Đơn & Phiếu Bàn Giao (Print Shipping Label)
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary rounded-pill px-4 ms-2">Đóng</button>
    </div>

    <div class="shipping-label-card">
        <!-- Carrier & Order Barcode Header -->
        <div class="d-flex justify-content-between align-items-center dashed-bottom pb-3 mb-3">
            <div>
                <span class="badge bg-dark text-white fs-6 px-3 py-1.5 rounded-1">@Model.CarrierName</span>
                <div class="text-secondary small mt-1 font-monospace">MÃ VẬN ĐƠN: <strong>@(string.IsNullOrEmpty(Model.TrackingNumber) ? "CHỜ_LẤY_MÃ" : Model.TrackingNumber)</strong></div>
            </div>
            <div class="text-end">
                <svg id="orderBarcode"></svg>
                <div class="font-monospace fw-bold small">@Model.OrderCode</div>
            </div>
        </div>

        <!-- Sender & Receiver Box -->
        <div class="row g-3 dashed-bottom pb-3 mb-3">
            <!-- Sender -->
            <div class="col-6 border-end pe-3">
                <div class="small text-uppercase text-secondary fw-bold mb-1">GỬI TỪ:</div>
                <div class="fw-bold text-dark">TECHZONE VIỆT NAM (TỔNG KHO TÂN BÌNH)</div>
                <div class="small text-secondary">Kho Vận & Logistics TechZone</div>
                <div class="small text-secondary">Đ/c: 123 Đường Cộng Hòa, P. 13, Q. Tân Bình, TP. Hồ Chí Minh</div>
                <div class="small fw-semibold mt-1">Hotline: 1900 8888</div>
            </div>
            <!-- Receiver -->
            <div class="col-6 ps-3">
                <div class="small text-uppercase text-secondary fw-bold mb-1">NGƯỜI NHẬN:</div>
                <div class="fw-bold fs-6 text-primary">@Model.CustomerName</div>
                <div class="fw-bold text-dark font-monospace fs-6">SĐT: @Model.CustomerPhone</div>
                <div class="small text-dark mt-1">Đ/c: @Model.ShippingAddress.FullAddress</div>
            </div>
        </div>

        <!-- Order Items & Assigned IMEIs Table -->
        <div class="mb-3 dashed-bottom pb-3">
            <div class="small text-uppercase text-secondary fw-bold mb-2">CHI TIẾT SẢN PHẨM & MÃ IMEI ĐÃ GÁN (KÍCH HOẠT BH):</div>
            <table class="table table-sm table-bordered align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>SKU</th>
                        <th class="text-center" style="width: 50px;">SL</th>
                        <th>Mã Định Danh Serial/IMEI Gán Theo Đơn</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@item.ProductName</td>
                            <td class="font-monospace">@item.VariantSku</td>
                            <td class="text-center font-monospace fw-bold">@item.Quantity</td>
                            <td>
                                @if (item.AssignedSerialNumbers.Any())
                                {
                                    <div class="font-monospace text-primary fw-bold">
                                        @string.Join(" | ", item.AssignedSerialNumbers)
                                    </div>
                                }
                                else
                                {
                                    <span class="text-danger small">Chưa quét Serial</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- COD & Payment Summary -->
        <div class="row align-items-center dashed-bottom pb-3 mb-3">
            <div class="col-7">
                <div class="small fw-semibold">Hình thức thanh toán: <span class="badge bg-light text-dark border">@Model.PaymentMethod</span></div>
                <div class="small text-secondary mt-1">Ghi chú bưu tá: Cho xem hàng, không thử. Hàng giá trị cao dễ vỡ.</div>
            </div>
            <div class="col-5 text-end">
                <div class="text-secondary small text-uppercase">TIỀN THU NGƯỜI NHẬN (COD):</div>
                @if (Model.PaymentMethod == PaymentMethod.COD && Model.PaymentStatus != PaymentStatus.Completed)
                {
                    <div class="fs-4 fw-bold text-danger font-monospace">@Model.TotalAmount.ToString("N0") VNĐ</div>
                }
                else
                {
                    <div class="fs-5 fw-bold text-success font-monospace">0 VNĐ (ĐÃ THANH TOÁN)</div>
                }
            </div>
        </div>

        <!-- Signatures -->
        <div class="row pt-2 text-center small text-secondary">
            <div class="col-4">
                <div class="fw-semibold text-dark">Thủ Kho Xuất Hàng</div>
                <div style="height: 45px;"></div>
                <div>(Ký & ghi rõ họ tên)</div>
            </div>
            <div class="col-4">
                <div class="fw-semibold text-dark">Bưu Tá Nhận Hàng</div>
                <div style="height: 45px;"></div>
                <div>(Ký & ghi rõ họ tên)</div>
            </div>
            <div class="col-4">
                <div class="fw-semibold text-dark">Chữ Ký Người Nhận</div>
                <div style="height: 45px;"></div>
                <div>(Xác nhận nguyên vẹn seal)</div>
            </div>
        </div>
    </div>

    <script>
        window.addEventListener('DOMContentLoaded', function() {
            JsBarcode("#orderBarcode", "@Model.OrderCode", {
                format: "CODE128",
                width: 1.6,
                height: 38,
                displayValue: false
            });
        });
    </script>
</body>
</html>
