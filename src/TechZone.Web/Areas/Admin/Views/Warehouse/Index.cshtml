<!-- 12. Modal Tiếp Nhận Hàng Hoàn & Cách Ly (Reverse Logistics) -->
<div class="modal fade" id="processReturnModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <form method="post" action="@Url.Action("ProcessCustomerReturn", "Warehouse")">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom px-4 pt-4 pb-3">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-arrow-return-left text-danger me-2"></i>Tiếp Nhận &amp; Đối Chiếu IMEI Hàng Hoàn
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Mã Đơn Hàng Gốc <span class="text-danger">*</span></label>
                        <input type="text" name="orderCode" class="form-control font-monospace" placeholder="VD: ORD-202610-A1B2" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Mã IMEI / Serial Trên Vỏ Hộp Hoàn Về <span class="text-danger">*</span></label>
                        <input type="text" name="serialNumber" class="form-control font-monospace form-control-lg text-danger fw-bold" placeholder="Quét barcode IMEI..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Phân Loại Xử Lý Sau Khi Kiểm Định <span class="text-danger">*</span></label>
                        <select name="returnType" class="form-select" required>
                            <option value="RestockGood">Nhập lại kho khả dụng (Nguyên seal, khách bom/hủy trước khi bóc)</option>
                            <option value="QuarantineDefective">Cách ly kho lỗi / Đổi trả Hãng (Đã bóc seal, trầy xước, lỗi NSX)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Kết Luận Ngoại Quan <span class="text-danger">*</span></label>
                        <input type="text" name="inspectionResult" class="form-control" placeholder="VD: Hộp nguyên vẹn 100%, chưa kích hoạt bảo hành..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Ghi Chú Bàn Giao</label>
                        <textarea name="actionNotes" class="form-control" rows="2" placeholder="Ghi chú thêm..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top px-4 py-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">Xác Nhận Tiếp Nhận</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openInspectModal(poId, poCode) {
            document.getElementById('inspect_poId').value = poId;
            document.getElementById('inspect_poCode').value = poCode;
            new bootstrap.Modal(document.getElementById('inspectPoModal')).show();
        }

        function openScanModal(poId, poCode, prodId, sku, prodName) {
            var poSelect = document.getElementById('scan_poId');
            if (poSelect) {
                poSelect.value = poId;
            }
            if (prodId) {
                document.getElementById('scan_productId').value = prodId;
            }
            if (sku) {
                document.getElementById('scan_sku').value = sku;
            }
            new bootstrap.Modal(document.getElementById('scanImeiBatchModal')).show();
        }

        function onPoSelectChanged(selectElem) {
            var selectedOption = selectElem.options[selectElem.selectedIndex];
            var prodId = selectedOption.getAttribute('data-productid');
            var sku = selectedOption.getAttribute('data-sku');
            if (prodId) {
                document.getElementById('scan_productId').value = prodId;
            }
            if (sku) {
                document.getElementById('scan_sku').value = sku;
            }
        }

        function updateScanCount(textarea) {
            var lines = textarea.value.split(/[\r\n,;]+/).filter(function(s) { return s.trim().length > 0; });
            document.getElementById('scan_count_label').innerText = lines.length + ' mã';
        }

        function openStatusModal(id, serial, currentStatus) {
            document.getElementById('status_itemId').value = id;
            document.getElementById('status_serial').value = serial;
            document.getElementById('status_select').value = currentStatus;
            new bootstrap.Modal(document.getElementById('updateStatusModal')).show();
        }

        function openBindSkuModal(id, serial, prodId, sku) {
            document.getElementById('bind_itemId').value = id;
            document.getElementById('bind_serial').value = serial;
            document.getElementById('bind_productId').value = prodId;
            document.getElementById('bind_sku').value = sku;
            new bootstrap.Modal(document.getElementById('bindSkuModal')).show();
        }

        function openDispatchModal(orderId, orderCode, sku, prodName) {
            document.getElementById('dispatch_orderId').value = orderId;
            document.getElementById('dispatch_orderCode').value = orderCode;
            document.getElementById('dispatch_sku').value = sku || '';
            document.getElementById('dispatch_serial').value = '';
            new bootstrap.Modal(document.getElementById('scanDispatchModal')).show();
        }

        function openHandoverModal(orderId, orderCode, carrierName) {
            document.getElementById('handover_orderId').value = orderId;
            document.getElementById('handover_orderCode').value = orderCode;
            if (carrierName) {
                document.getElementById('handover_carrier').value = carrierName;
            }
            new bootstrap.Modal(document.getElementById('handoverCarrierModal')).show();
        }

        function openCountModal(sessionId, sessionCode) {
            document.getElementById('count_sessionId').value = sessionId;
            document.getElementById('count_sessionCode').value = sessionCode;
            new bootstrap.Modal(document.getElementById('submitStocktakeCountModal')).show();
        }

        function openThresholdModal(prodId, prodName, currentThreshold) {
            document.getElementById('threshold_productId').value = prodId;
            document.getElementById('threshold_prodName').value = prodName;
            document.getElementById('threshold_val').value = currentThreshold;
            new bootstrap.Modal(document.getElementById('safetyThresholdModal')).show();
        }

        function onTrfProductChanged(selectElem) {
            var selectedOption = selectElem.options[selectElem.selectedIndex];
            var sku = selectedOption.getAttribute('data-sku');
            if (sku) {
                document.getElementById('trf_sku').value = sku;
            }
        }
    </script>
}
