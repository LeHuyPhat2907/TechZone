<!-- 1. Modal Kiểm Định Ngoại Quan PO -->
<div class="modal fade" id="inspectPoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <form method="post" action="@Url.Action("InspectInboundBatch", "Warehouse")">
