        </div>
    </div>
</div>

<!-- 7. Modal Khởi Tạo Phiên Kiểm Kê Kho Mới -->
<div class="modal fade" id="createStocktakeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <form method="post" action="@Url.Action("CreateStocktakeSession", "Warehouse")">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom px-4 pt-4 pb-3">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-clipboard2-check text-dark me-2"></i>Khởi Tạo Phiên Kiểm Kê Kho Mới
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Tiêu Đề Đợt Kiểm Kê <span class="text-danger">*</span></label>
                        <input type="text" name="title" class="form-control" value="Kiểm kê định kỳ tháng @DateTime.UtcNow.Month/@DateTime.UtcNow.Year" required />
                    </div>
                    <div class="mb-3">
