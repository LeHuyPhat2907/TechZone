                <input type="hidden" name="poId" id="inspect_poId" />
                <div class="modal-header border-bottom px-4 pt-4 pb-3">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-search text-info me-2"></i>Kiểm Định Ngoại Quan Kiện Hàng PO
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Mã Đơn Đặt Hàng PO</label>
                        <input type="text" id="inspect_poCode" class="form-control font-monospace bg-light" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Kết Quả Kiểm Định <span class="text-danger">*</span></label>
                        <select name="inspectionResult" class="form-select" required>
                            <option value="Đạt 100% (Seal nguyên vẹn, bao bì chuẩn hãng)">Đạt 100% (Seal nguyên vẹn, bao bì chuẩn hãng)</option>
                            <option value="Đạt một phần (Có kiện cấn móp vỏ thùng bên ngoài)">Đạt một phần (Có kiện cấn móp vỏ thùng bên ngoài)</option>
                            <option value="Không đạt (Phát hiện rách seal, thiếu phụ kiện hoặc ướt nước)">Không đạt (Phát hiện rách seal, thiếu phụ kiện hoặc ướt nước)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Ghi Chú Chi Tiết Biên Bản</label>
                        <textarea name="defectNotes" class="form-control" rows="3" placeholder="Ghi chú chi tiết nếu có hư hại..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top px-4 py-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-info text-dark rounded-pill px-4 fw-semibold">Lưu Biên Bản</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 2. Modal Quét Nhập IMEI Khui Kiện (Batch Scan) -->
<div class="modal fade" id="scanImeiBatchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <form method="post" action="@Url.Action("ScanImeiBatch", "Warehouse")">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom px-4 pt-4 pb-3">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-upc-scan text-success me-2"></i>Quét &amp; Import Danh Sách IMEI Khui Kiện (Batch Scan)
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Đơn Hàng Nhập PO <span class="text-danger">*</span></label>
                            <select name="poId" id="scan_poId" class="form-select" required onchange="onPoSelectChanged(this)">
                                @foreach (var po in Model.PurchaseOrders.Where(p => p.Status != "FullyReceived"))
                                {
                                    <option value="@po.Id" data-productid="@po.Items.FirstOrDefault()?.ProductId" data-sku="@po.Items.FirstOrDefault()?.Sku" data-prodname="@po.Items.FirstOrDefault()?.ProductName">
                                        @po.PoCode - @po.SupplierName (@po.Items.FirstOrDefault()?.ProductName)
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Vị Trí Kệ Kho Xếp Hàng</label>
                            <input type="text" name="warehouseLocation" class="form-control" value="Kệ A1-Kho Tổng" required />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Sản Phẩm Mục Tiêu <span class="text-danger">*</span></label>
                            <select name="productId" id="scan_productId" class="form-select" required>
                                @foreach (var p in Model.AvailableProducts)
                                {
                                    <option value="@p.Id">@p.Name (@p.Sku)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Mã SKU Biến Thể <span class="text-danger">*</span></label>
                            <input type="text" name="variantSku" id="scan_sku" class="form-control font-monospace" placeholder="VD: IP15PM-256-NATURAL" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary d-flex justify-content-between">
                            <span>Danh Sách Mã IMEI / Serial Number (Mỗi mã 1 dòng hoặc cách nhau bởi dấu phẩy)</span>
                            <span class="text-muted small" id="scan_count_label">0 mã</span>
                        </label>
                        <textarea name="rawSerials" id="scan_rawSerials" class="form-control font-monospace" rows="6" placeholder="Quét trực tiếp từ máy barcode scanner hoặc dán danh sách IMEI...&#10;352490123456789&#10;352490123456790" required oninput="updateScanCount(this)"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top px-4 py-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success text-white rounded-pill px-4 fw-semibold">
                        <i class="bi bi-box-arrow-in-down me-1"></i> Xác Nhận Nhập Kho
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 3. Modal Đổi Trạng Thái IMEI -->
