@model List<TechZone.Web.Areas.Admin.Models.PickListItemDto>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Phiếu Nhặt Hàng Tối Ưu (Pick List) - TechZone</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        @@media print {
            .no-print {
                display: none !important;
            }
            body {
                margin: 0;
                padding: 15mm;
            }
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: #1e293b;
        }
        .header-box {
            border-bottom: 2px solid #0f172a;
            padding-bottom: 12px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body class="p-4">
    <div class="text-end no-print mb-3">
        <button onclick="window.print()" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
            🖨️ In Phiếu Nhặt Hàng (Print Pick List)
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary rounded-pill px-4 ms-2">Đóng</button>
    </div>

    <div class="header-box d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold text-dark mb-0">TECHZONE VIỆT NAM - PHIẾU NHẶT HÀNG (PICK LIST)</h3>
            <div class="text-secondary small mt-1">Lộ trình tối ưu hóa vị trí kệ hàng kho đóng gói xuất bưu tá</div>
        </div>
        <div class="text-end">
            <div class="fw-bold font-monospace">NGÀY: @DateTime.UtcNow.ToString("dd/MM/yyyy HH:mm")</div>
            <div class="small text-muted">Thủ Kho: @User.Identity?.Name</div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4">
            Hiện không có mặt hàng nào cần nhặt kho. Tất cả đơn hàng đã được soạn đủ hoặc chưa có đơn mới.
        </div>
    }
    else
    {
        <table class="table table-bordered align-middle">
            <thead class="table-dark text-uppercase small">
                <tr>
                    <th style="width: 50px;" class="text-center">Xong</th>
                    <th style="width: 140px;">Vị Trí Kệ Kho</th>
                    <th>Tên Sản Phẩm &amp; Phân Loại</th>
                    <th>Mã SKU</th>
                    <th class="text-center" style="width: 100px;">Cần Nhặt</th>
                    <th class="text-center" style="width: 100px;">Tồn Kệ</th>
                    <th>Thuộc Các Đơn Hàng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pick in Model)
                {
                    <tr>
                        <td class="text-center">
                            <input type="checkbox" style="width: 18px; height: 18px;" />
                        </td>
                        <td class="fw-bold font-monospace text-primary">
                            @pick.WarehouseLocation
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">@pick.ProductName</div>
                            <div class="text-secondary small">@pick.VariantName</div>
                        </td>
                        <td class="font-monospace fw-bold">@pick.Sku</td>
                        <td class="text-center font-monospace fs-5 fw-bold text-danger">@pick.RequiredQuantity</td>
                        <td class="text-center font-monospace text-success fw-semibold">@pick.InStockQuantity</td>
                        <td>
                            @foreach (var orderCode in pick.OrderCodes)
                            {
                                <span class="badge bg-light text-dark border font-monospace me-1">@orderCode</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="row mt-5 pt-3">
            <div class="col-6 text-center">
                <div class="fw-semibold">Người Nhặt Hàng (Ký &amp; Ghi Rõ Họ Tên)</div>
                <div style="height: 60px;"></div>
                <div class="text-muted small">...................................................</div>
            </div>
            <div class="col-6 text-center">
                <div class="fw-semibold">Thủ Kho Kiểm Soát Đối Soát</div>
                <div style="height: 60px;"></div>
                <div class="text-muted small">...................................................</div>
            </div>
        </div>
    }
</body>
</html>
