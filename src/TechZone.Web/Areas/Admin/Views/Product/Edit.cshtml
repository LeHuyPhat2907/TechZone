@model ProductEditViewModel
@{
    ViewData["Title"] = $"Chỉnh Sửa: {Model.Name}";
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a href="/Admin/Product" class="text-decoration-none">Quản Lý Sản Phẩm</a></li>
                <li class="breadcrumb-item"><a href="/Admin/Product/Details/@Model.Id" class="text-decoration-none">@Model.Name</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa</li>
            </ol>
        </nav>
        <h3 class="fw-bold text-dark m-0 d-flex align-items-center gap-2">
            <span class="tz-stat-icon-wrapper" style="width: 38px; height: 38px; border-radius: 10px; background: rgba(2, 132, 199, 0.12); color: #0284c7; font-size: 1.15rem;">
                <i class="bi bi-pencil-square"></i>
            </span>
            <span>Chỉnh Sửa Thiết Bị / Sản Phẩm</span>
        </h3>
        <small class="text-muted">Mã SKU: <strong class="text-dark">@Model.Sku</strong> | ID: <code>@Model.Id</code></small>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/Admin/Product/Details/@Model.Id" class="btn btn-outline-secondary rounded-pill px-3 py-2 btn-sm d-flex align-items-center gap-1 shadow-2xs">
            <i class="bi bi-eye"></i>
            <span>Xem Chi Tiết</span>
        </a>
        <a href="/Admin/Attributes?productId=@Model.Id" class="btn btn-outline-info rounded-pill px-3 py-2 btn-sm d-flex align-items-center gap-1 shadow-2xs">
            <i class="bi bi-sliders"></i>
            <span>Sửa Thông Số (RAM/CPU)</span>
        </a>
        <button type="submit" form="productForm" class="btn btn-primary rounded-pill px-4 py-2 btn-sm d-flex align-items-center gap-2 shadow-sm fw-bold">
            <i class="bi bi-check2-circle fs-6"></i>
            <span>Cập Nhật Thay Đổi</span>
        </button>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="productForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4"></div>

    <div class="row g-4">
        <!-- Main Form Column (Left 8 Cols) -->
        <div class="col-lg-8">
            <!-- 1. Thông Tin Cơ Bản Thiết Bị -->
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
                <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle-fill text-primary"></i>
                    <span>1. Thông Tin Thiết Bị Cơ Bản</span>
                </h5>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold small text-dark"></label> <span class="text-danger">*</span>
                        <input asp-for="Name" class="form-control" id="productNameInput" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Sku" class="form-label fw-semibold small text-dark"></label> <span class="text-danger">*</span>
                        <input asp-for="Sku" class="form-control text-uppercase" required />
                        <span asp-validation-for="Sku" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-semibold small text-dark"></label> <span class="text-danger">*</span>
                        <select asp-for="CategoryId" class="form-select" required>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId)">@cat.Name</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="BrandId" class="form-label fw-semibold small text-dark"></label> <span class="text-danger">*</span>
                        <select asp-for="BrandId" class="form-select" required>
                            @foreach (var brand in Model.Brands)
                            {
                                <option value="@brand.Id" selected="@(brand.Id == Model.BrandId)">@brand.Name (@brand.CountryOfOrigin)</option>
                            }
                        </select>
                        <span asp-validation-for="BrandId" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Slug" class="form-label fw-semibold small text-dark"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light small text-muted">/product/</span>
                            <input asp-for="Slug" class="form-control" id="productSlugInput" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Giá Cả & Chính Sách Bán Buôn (RBAC product.price_override) -->
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold text-dark m-0 d-flex align-items-center gap-2">
                        <i class="bi bi-tag-fill text-success"></i>
                        <span>2. Giá Bán & Chính Sách Bán Buôn (RBAC)</span>
                    </h5>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 small">
                        <i class="bi bi-shield-lock me-1"></i>product.price_override
                    </span>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="OriginalPrice" class="form-label fw-semibold small text-dark"></label> <span class="text-danger">*</span>
                        <div class="input-group">
                            <input asp-for="OriginalPrice" type="number" class="form-control fw-bold" min="0" step="1000" id="origPriceInput" required />
                            <span class="input-group-text bg-light">₫</span>
                        </div>
                        <span asp-validation-for="OriginalPrice" class="text-danger small"></span>
                        <small class="text-muted" style="font-size: 0.72rem;">Giá niêm yết gốc của hãng sản xuất.</small>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Price" class="form-label fw-semibold small text-dark"></label> <span class="text-danger">*</span>
                        <div class="input-group">
                            <input asp-for="Price" type="number" class="form-control fw-bold text-danger fs-6" min="0" step="1000" id="salePriceInput" required />
                            <span class="input-group-text bg-light">₫</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                        <small class="text-muted" style="font-size: 0.72rem;">Giá bán lẻ trực tiếp tới khách hàng.</small>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="WholesalePrice" class="form-label fw-semibold small text-dark"></label>
                        <div class="input-group">
                            <input asp-for="WholesalePrice" type="number" class="form-control fw-bold text-primary" min="0" step="1000" />
                            <span class="input-group-text bg-light">₫</span>
                        </div>
                        <span asp-validation-for="WholesalePrice" class="text-danger small"></span>
                        <small class="text-muted" style="font-size: 0.72rem;">Giá bán buôn / bán sỉ (B2B).</small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="WarrantyMonths" class="form-label fw-semibold small text-dark"></label>
                        <div class="input-group">
                            <input asp-for="WarrantyMonths" type="number" class="form-control" min="0" max="120" />
                            <span class="input-group-text bg-light">Tháng</span>
                        </div>
                        <small class="text-muted" style="font-size: 0.72rem;">Bảo hành điện tử chính hãng theo số IMEI/Serial.</small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StockQuantity" class="form-label fw-semibold small text-dark"></label>
                        <div class="input-group">
                            <input asp-for="StockQuantity" type="number" class="form-control fw-bold" min="0" />
                            <span class="input-group-text bg-light">Chiếc</span>
                        </div>
                        <small class="text-muted" style="font-size: 0.72rem;">Số lượng tồn kho vật lý thực tế.</small>
                    </div>
                </div>
            </div>

            <!-- 3. Bài Viết Mô Tả Sản Phẩm Chuyên Sâu -->
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
                <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-richtext-fill text-info"></i>
                    <span>3. Bài Viết Mô Tả & Đánh Giá Sản Phẩm</span>
                </h5>

                <div class="mb-3">
                    <label asp-for="ShortDescription" class="form-label fw-semibold small text-dark"></label>
                    <textarea asp-for="ShortDescription" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="ShortDescription" class="text-danger small"></span>
                </div>

                <div class="mb-2">
                    <label asp-for="Description" class="form-label fw-semibold small text-dark"></label>
                    <textarea asp-for="Description" class="form-control" rows="10"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                    <small class="text-muted" style="font-size: 0.72rem;">Hỗ trợ định dạng văn bản / HTML bài viết mở hộp, trải nghiệm người dùng, tính năng vượt trội.</small>
                </div>
            </div>

            <!-- 4. Thư Viện Ảnh & Video Mở Hộp (Unbox / Review) -->
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
                <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-images text-warning"></i>
                    <span>4. Thư Viện Ảnh & Video Unbox / Review</span>
                </h5>

                <!-- Thumbnail -->
                <div class="mb-4">
                    <label asp-for="ThumbnailUrl" class="form-label fw-semibold small text-dark"></label> <span class="text-danger">*</span>
                    <div class="input-group mb-2">
                        <span class="input-group-text bg-light"><i class="bi bi-image"></i></span>
                        <input asp-for="ThumbnailUrl" class="form-control" id="thumbnailInput" required />
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="previewThumbnail()">
                            <i class="bi bi-eye me-1"></i>Xem trước
                        </button>
                    </div>
                    <span asp-validation-for="ThumbnailUrl" class="text-danger small"></span>

                    <!-- Thumbnail Live Preview -->
                    <div id="thumbPreviewBox" class="p-2 border rounded-3 bg-light text-center" style="max-width: 140px;">
                        <img id="thumbImg" src="@Model.ThumbnailUrl" alt="Thumbnail preview" class="img-fluid rounded" style="max-height: 100px; object-fit: contain;" onerror="this.src='/images/placeholder.svg';" />
                    </div>
                </div>

                <!-- Video Unbox / Review -->
                <div class="mb-4">
                    <label asp-for="VideoUrl" class="form-label fw-semibold small text-dark"></label>
                    <div class="input-group mb-2">
                        <span class="input-group-text bg-light"><i class="bi bi-youtube text-danger"></i></span>
                        <input asp-for="VideoUrl" class="form-control" placeholder="https://www.youtube.com/watch?v=... hoặc link video mp4 unbox" id="videoUrlInput" />
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="previewVideo()">
                            <i class="bi bi-play-btn me-1"></i>Xem video
                        </button>
                    </div>
                    <small class="text-muted" style="font-size: 0.72rem;">Hỗ trợ link YouTube review / mở hộp thiết bị hoặc video trực tiếp.</small>

                    <!-- Video Live Preview -->
                    <div id="videoPreviewBox" class="mt-2 border rounded-4 p-2 bg-dark text-center" style="display: none; max-width: 480px;">
                        <div class="ratio ratio-16x9">
                            <iframe id="videoIframe" src="" title="Video preview" allowfullscreen class="rounded-3"></iframe>
                        </div>
                    </div>
                </div>

                <!-- Gallery Images Dynamic List -->
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <label class="form-label fw-semibold small text-dark m-0">Thư viện ảnh chi tiết (Gallery)</label>
                        <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-1" onclick="addGalleryImageRow()">
                            <i class="bi bi-plus-lg me-1"></i>Thêm ảnh phụ
                        </button>
                    </div>
                    <p class="text-muted small mb-2" style="font-size: 0.75rem;">Danh sách ảnh chi tiết các góc cạnh, phụ kiện và màu sắc máy.</p>

                    <input type="hidden" asp-for="GalleryImagesJson" id="galleryImagesJson" value="@Model.GalleryImagesJson" />

                    <div class="table-responsive border rounded-3">
                        <table class="table table-sm table-hover align-middle mb-0" id="galleryTable">
                            <thead class="table-light small">
                                <tr>
                                    <th style="width: 45%;">Đường dẫn ảnh (URL)</th>
                                    <th style="width: 25%;">Phiên bản màu</th>
                                    <th style="width: 15%;">Thứ tự</th>
                                    <th style="width: 15%;" class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="galleryBody">
                                <!-- Dynamic rows via JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Options (Right 4 Cols) -->
        <div class="col-lg-4">
            <!-- Trạng Thái Kinh Doanh -->
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
                <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-toggle-on text-primary"></i>
                    <span>Trạng Thái Kinh Doanh</span>
                </h6>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive" id="isActiveSwitch">
                    <label class="form-check-label fw-semibold small text-dark" for="isActiveSwitch">Mở bán trên Storefront</label>
                    <div class="text-muted" style="font-size: 0.72rem;">Khi tắt, sản phẩm sẽ tạm ẩn khỏi website bán lẻ.</div>
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" role="switch" asp-for="IsFeatured" id="isFeaturedSwitch">
                    <label class="form-check-label fw-semibold small text-dark" for="isFeaturedSwitch">Sản phẩm tiêu biểu (Featured)</label>
                    <div class="text-muted" style="font-size: 0.72rem;">Xuất hiện tại banner/sản phẩm nổi bật trang chủ.</div>
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" role="switch" asp-for="IsNewArrival" id="isNewArrivalSwitch">
                    <label class="form-check-label fw-semibold small text-dark" for="isNewArrivalSwitch">Hàng mới về (New Arrival)</label>
                    <div class="text-muted" style="font-size: 0.72rem;">Gắn nhãn New Arrival màu xanh trên thẻ sản phẩm.</div>
                </div>

                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" asp-for="IsBestSeller" id="isBestSellerSwitch">
                    <label class="form-check-label fw-semibold small text-dark" for="isBestSellerSwitch">Bán chạy nhất (Best Seller)</label>
                    <div class="text-muted" style="font-size: 0.72rem;">Gắn huy hiệu Best Seller ưu tiên lên trang danh mục.</div>
                </div>
            </div>

            <!-- Thông Số Nổi Bật (Highlight Specs) -->
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
                <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                    <i class="bi bi-stars text-warning"></i>
                    <span>Thông Số Nổi Bật (Pills)</span>
                </h6>
                <p class="text-muted small mb-2" style="font-size: 0.75rem;">Các thông số chính hiển thị dưới dạng viên thuốc (badge) ở đầu trang chi tiết.</p>
                <textarea asp-for="HighlightSpecsRaw" class="form-control small mb-2" rows="3" id="highlightSpecsInput"></textarea>
                <small class="text-muted" style="font-size: 0.72rem;">Phân cách các thông số bằng dấu phẩy (<code>,</code>).</small>
            </div>

            <!-- Tags / Thẻ Tìm Kiếm -->
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
                <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                    <i class="bi bi-hash text-secondary"></i>
                    <span>Thẻ Tìm Kiếm / Tags</span>
                </h6>
                <input asp-for="TagsRaw" class="form-control small" />
                <small class="text-muted" style="font-size: 0.72rem;">Phân cách bằng dấu phẩy.</small>
            </div>

            <!-- Cấu Hình Phần Cứng -->
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
                <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                    <i class="bi bi-sliders text-info"></i>
                    <span>Thông Số Kỹ Thuật (attribute.manage)</span>
                </h6>
                <p class="text-muted small mb-3" style="font-size: 0.75rem;">
                    Quản lý bảng thông số kỹ thuật chi tiết của thiết bị (RAM, CPU, Pin, Độ phân giải màn hình...).
                </p>
                <a href="/Admin/Attributes?productId=@Model.Id" class="btn btn-outline-info rounded-pill w-100 fw-bold btn-sm py-2">
                    <i class="bi bi-sliders me-1"></i>Mở Bảng Thông Số Kỹ Thuật
                </a>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" form="productForm" class="btn btn-primary rounded-pill py-2 fw-bold shadow-sm">
                    <i class="bi bi-check2-circle me-1"></i>Lưu Cập Nhật
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewThumbnail() {
            var url = document.getElementById('thumbnailInput').value.trim();
            var box = document.getElementById('thumbPreviewBox');
            var img = document.getElementById('thumbImg');
            if (url) {
                img.src = url;
                box.style.display = 'block';
            } else {
                box.style.display = 'none';
            }
        }

        function previewVideo() {
            var url = document.getElementById('videoUrlInput').value.trim();
            var box = document.getElementById('videoPreviewBox');
            var iframe = document.getElementById('videoIframe');
            if (!url) {
                box.style.display = 'none';
                return;
            }

            var embedUrl = getYouTubeEmbedUrl(url);
            if (embedUrl) {
                iframe.src = embedUrl;
                box.style.display = 'block';
            } else {
                box.style.display = 'none';
            }
        }

        function getYouTubeEmbedUrl(url) {
            if (!url) return '';
            var regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
            var match = url.match(regExp);
            return (match && match[2].length === 11) ? ('https://www.youtube.com/embed/' + match[2]) : '';
        }

        // Gallery Dynamic Table
        var galleryItems = [];
        try {
            var rawJson = document.getElementById('galleryImagesJson').value;
            if (rawJson) {
                galleryItems = JSON.parse(rawJson);
            }
        } catch (e) {
            galleryItems = [];
        }

        function renderGalleryTable() {
            var tbody = document.getElementById('galleryBody');
            tbody.innerHTML = '';

            if (!galleryItems || galleryItems.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted small py-3">Chưa có ảnh phụ nào trong thư viện. Bấm "Thêm ảnh phụ" để thêm.</td></tr>';
                document.getElementById('galleryImagesJson').value = '[]';
                return;
            }

            galleryItems.forEach(function(item, idx) {
                var tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>
                        <input type="text" class="form-control form-control-sm" value="${escapeHtml(item.Url || item.url || '')}" placeholder="https://..." onchange="updateGalleryItem(${idx}, 'Url', this.value)" />
                    </td>
                    <td>
                        <input type="text" class="form-control form-control-sm" value="${escapeHtml(item.ColorTag || item.colorTag || '')}" placeholder="Vd: Titan Tự Nhiên" onchange="updateGalleryItem(${idx}, 'ColorTag', this.value)" />
                    </td>
                    <td>
                        <input type="number" class="form-control form-control-sm" value="${item.DisplayOrder || item.displayOrder || (idx + 1)}" min="1" onchange="updateGalleryItem(${idx}, 'DisplayOrder', parseInt(this.value))" />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-xs btn-outline-danger rounded-pill px-2 py-1" onclick="removeGalleryItem(${idx})">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('galleryImagesJson').value = JSON.stringify(galleryItems);
        }

        function addGalleryImageRow() {
            galleryItems.push({
                Url: '',
                ColorTag: '',
                DisplayOrder: galleryItems.length + 1
            });
            renderGalleryTable();
        }

        function updateGalleryItem(index, key, val) {
            if (galleryItems[index]) {
                galleryItems[index][key] = val;
                document.getElementById('galleryImagesJson').value = JSON.stringify(galleryItems);
            }
        }

        function removeGalleryItem(index) {
            galleryItems.splice(index, 1);
            renderGalleryTable();
        }

        function escapeHtml(text) {
            if (!text) return '';
            return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        document.getElementById('thumbnailInput')?.addEventListener('change', previewThumbnail);
        document.getElementById('videoUrlInput')?.addEventListener('change', previewVideo);

        // Init
        previewThumbnail();
        previewVideo();
        renderGalleryTable();
    </script>
}
