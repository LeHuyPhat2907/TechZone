@model TechZone.Web.Areas.Admin.Models.MediaLibraryViewModel
@{
    ViewData["Title"] = "Quản Lý Media & Thư Viện Hình Ảnh";
}

<div class="container-fluid py-4 px-md-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Admin</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Thư viện Media</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark m-0 d-flex align-items-center gap-2">
                <i class="bi bi-images text-primary"></i> Quản Lý Media & Thư Viện Hình Ảnh
            </h3>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                <i class="bi bi-hdd-network-fill me-1"></i> Lưu trữ: @Model.Settings.Provider Storage (Proxmox/Local)
            </span>
            <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2 rounded-pill">
                <i class="bi bi-cloud-check-fill me-1"></i> Cloudinary: 25GB Free Tier
            </span>
        </div>
    </div>

    <!-- Storage Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 rounded-4 shadow-sm p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Tổng số tệp ảnh</div>
                        <div class="fs-4 fw-bold text-dark mt-1" id="statTotalCount">@Model.TotalFilesCount</div>
                    </div>
                    <div class="bg-primary-subtle text-primary p-3 rounded-4 fs-4">
                        <i class="bi bi-file-earmark-image"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 rounded-4 shadow-sm p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Dung lượng sử dụng</div>
                        <div class="fs-4 fw-bold text-primary mt-1" id="statTotalSize">@Model.TotalBytesFormatted</div>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-4 fs-4">
                        <i class="bi bi-pie-chart-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 rounded-4 shadow-sm p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Giới hạn tệp tối đa</div>
                        <div class="fs-4 fw-bold text-dark mt-1">@(Model.Settings.MaxFileSizeBytes / (1024 * 1024)) MB</div>
                    </div>
                    <div class="bg-warning-subtle text-warning p-3 rounded-4 fs-4">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 rounded-4 shadow-sm p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Định dạng hỗ trợ</div>
                        <div class="fw-bold text-secondary mt-1 small">WEBP, JPG, PNG, GIF, SVG</div>
                    </div>
                    <div class="bg-info-subtle text-info p-3 rounded-4 fs-4">
                        <i class="bi bi-magic"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Drag & Drop Upload Zone -->
    <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
        <h5 class="fw-bold text-dark mb-3">
            <i class="bi bi-cloud-arrow-up-fill text-primary me-2"></i>Tải Lên Hình Ảnh Mới
        </h5>

        <form id="uploadForm" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="p-4 border-2 border-dashed rounded-4 text-center bg-light cursor-pointer position-relative mb-3" id="dropZone" style="border: 2px dashed #94a3b8; transition: all 0.2s;">
                <input type="file" id="fileInput" name="file" accept=".jpg,.jpeg,.png,.webp,.gif,.svg" class="position-absolute top-0 start-0 w-100 h-100 opacity-0 cursor-pointer" onchange="handleFileSelected(this)" />
                <div class="py-3">
                    <i class="bi bi-cloud-arrow-up text-primary fs-1 d-block mb-2"></i>
                    <h6 class="fw-bold text-dark mb-1">Kéo thả tệp ảnh vào đây hoặc nhấp để duyệt file từ máy tính</h6>
                    <p class="text-muted small mb-0">Hỗ trợ định dạng .webp, .jpg, .png, .svg (Dung lượng tối đa 5MB / ảnh)</p>
                </div>
            </div>

            <!-- Selected File Preview & Upload Controls -->
            <div id="uploadPreviewSection" class="row g-3 align-items-center d-none p-3 border rounded-3 bg-white mb-3">
                <div class="col-auto">
                    <img id="imagePreview" src="#" alt="Preview" class="rounded-3 border object-fit-contain" style="width: 80px; height: 80px;" />
                </div>
                <div class="col">
                    <div class="fw-bold text-dark text-truncate" id="selectedFileName">file_name.jpg</div>
                    <div class="text-muted small" id="selectedFileSize">0 KB</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Thư mục đích:</label>
                    <select id="uploadFolderSelect" class="form-select form-select-sm rounded-3">
                        <option value="products" selected>Sản phẩm (products)</option>
                        <option value="banners">Banner khuyến mãi (banners)</option>
                        <option value="reviews">Đánh giá khách hàng (reviews)</option>
                        <option value="avatars">Avatar thành viên (avatars)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="chkWatermark" checked />
                        <label class="form-check-label small fw-semibold text-dark" for="chkWatermark">
                            <i class="bi bi-patch-check text-primary me-1"></i>Đóng dấu bản quyền TechZone
                        </label>
                    </div>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" id="btnUpload" onclick="submitUpload()">
                        <i class="bi bi-upload me-1"></i>Tải Lên Ngay
                    </button>
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 ms-1" onclick="cancelUpload()">
                        Hủy
                    </button>
                </div>
            </div>

            <!-- Upload Progress Bar -->
            <div class="progress d-none mb-3" id="uploadProgressBar" style="height: 8px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 100%"></div>
            </div>
        </form>
    </div>

    <!-- Folder Navigation Tabs & Filter -->
    <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <!-- Tabs -->
            <ul class="nav nav-pills gap-2">
                <li class="nav-item">
                    <a asp-action="Index" asp-route-folder="all" class="nav-link rounded-pill px-3 @(Model.CurrentFolder == "all" ? "active" : "bg-light text-dark")">
                        <i class="bi bi-grid-fill me-1"></i>Tất cả
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Index" asp-route-folder="products" class="nav-link rounded-pill px-3 @(Model.CurrentFolder == "products" ? "active" : "bg-light text-dark")">
                        <i class="bi bi-phone me-1"></i>Sản phẩm
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Index" asp-route-folder="banners" class="nav-link rounded-pill px-3 @(Model.CurrentFolder == "banners" ? "active" : "bg-light text-dark")">
                        <i class="bi bi-badge-ad me-1"></i>Banner
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Index" asp-route-folder="reviews" class="nav-link rounded-pill px-3 @(Model.CurrentFolder == "reviews" ? "active" : "bg-light text-dark")">
                        <i class="bi bi-chat-heart me-1"></i>Đánh giá
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Index" asp-route-folder="avatars" class="nav-link rounded-pill px-3 @(Model.CurrentFolder == "avatars" ? "active" : "bg-light text-dark")">
                        <i class="bi bi-person-circle me-1"></i>Avatar
                    </a>
                </li>
            </ul>

            <!-- Search / Quick Filter -->
            <div class="d-flex align-items-center gap-2">
                <input type="text" id="filterInput" class="form-control form-control-sm rounded-pill px-3" placeholder="Lọc theo tên tệp..." onkeyup="filterMediaCards(this.value)" />
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="location.reload()">
                    <i class="bi bi-arrow-clockwise"></i> Làm mới
                </button>
            </div>
        </div>

        <!-- Media Grid -->
        <div class="row g-3" id="mediaGalleryContainer">
            @if (Model.Files.Count == 0)
            {
                <div class="col-12 text-center py-5">
                    <i class="bi bi-images text-muted fs-1 d-block mb-2"></i>
                    <h6 class="fw-bold text-dark">Thư mục chưa có tệp ảnh nào</h6>
                    <p class="text-muted small">Hãy kéo thả hoặc chọn tệp ảnh ở khung bên trên để tải lên hệ thống.</p>
                </div>
            }
            else
            {
                @foreach (var file in Model.Files)
                {
                    <div class="col-6 col-md-4 col-lg-3 col-xl-2 media-card-item" data-filename="@(file.FileName?.ToLower() ?? "")">
                        <div class="card h-100 border rounded-4 overflow-hidden shadow-sm position-relative">
                            <!-- Image thumbnail -->
                            <div class="p-2 bg-light text-center position-relative" style="height: 150px;">
                                <img src="@file.FileUrl" alt="@file.FileName" class="w-100 h-100 object-fit-contain rounded-3" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/images/placeholder.svg';" />
                                <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75" style="font-size: 0.65rem;">
                                    @file.Folder
                                </span>
                            </div>

                            <!-- Card Details -->
                            <div class="p-2 d-flex flex-column justify-content-between flex-grow-1">
                                <div class="fw-semibold text-dark text-truncate small mb-1" title="@file.FileName">
                                    @file.FileName
                                </div>
                                <div class="d-flex justify-content-between align-items-center text-muted small mb-2" style="font-size: 0.72rem;">
                                    <span>@file.FileSizeFormatted</span>
                                    <span>@file.UploadedAt.ToString("dd/MM/yyyy")</span>
                                </div>

                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-primary flex-fill py-1 small rounded-3" onclick="copyFileUrl('@file.FileUrl')" title="Sao chép URL ảnh">
                                        <i class="bi bi-clipboard me-1"></i>Copy
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-3" onclick="openPreviewModal('@file.FileUrl', '@file.FileName', '@file.FileSizeFormatted')" title="Xem chi tiết">
                                        <i class="bi bi-zoom-in"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-1 px-2 rounded-3" onclick="deleteFile('@file.FileUrl')" title="Xóa tệp này">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Modal Xem Chi Tiết Ảnh Phóng To -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold text-dark text-truncate" id="modalFileName">Tên file</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-4">
                <img id="modalPreviewImage" src="#" alt="Preview" class="img-fluid rounded-3 shadow-sm mb-3" style="max-height: 500px; object-fit: contain;" />
                <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded-3 small">
                    <span id="modalFileSize" class="text-muted">Kích thước: 0 KB</span>
                    <div class="d-flex gap-2">
                        <a id="modalDirectLink" href="#" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                            <i class="bi bi-box-arrow-up-right me-1"></i>Mở trong tab mới
                        </a>
                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" onclick="copyCurrentModalUrl()">
                            <i class="bi bi-clipboard me-1"></i>Copy URL
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast Thông Báo -->
<div class="toast-container position-fixed bottom-0 end-0 p-3 z-3">
    <div id="liveToast" class="toast align-items-center text-white bg-dark border-0 rounded-4 shadow" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2" id="toastMessage">
                <i class="bi bi-check-circle-fill text-success fs-5"></i> Đã thực hiện thành công.
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentModalUrl = '';

        function showToast(msg, isSuccess = true) {
            const toastEl = document.getElementById('liveToast');
            const toastBody = document.getElementById('toastMessage');
            toastBody.innerHTML = isSuccess 
                ? `<i class="bi bi-check-circle-fill text-success fs-5"></i> ${msg}`
                : `<i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i> ${msg}`;
            const toast = new bootstrap.Toast(toastEl, { delay: 3500 });
            toast.show();
        }

        function handleFileSelected(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                document.getElementById('selectedFileName').innerText = file.name;
                document.getElementById('selectedFileSize').innerText = (file.size / 1024).toFixed(1) + ' KB';

                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imagePreview').src = e.target.result;
                    document.getElementById('uploadPreviewSection').classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            }
        }

        function cancelUpload() {
            document.getElementById('fileInput').value = '';
            document.getElementById('uploadPreviewSection').classList.add('d-none');
        }

        async function submitUpload() {
            const fileInput = document.getElementById('fileInput');
            if (!fileInput.files || fileInput.files.length === 0) {
                showToast("Vui lòng chọn tệp ảnh.", false);
                return;
            }

            const formData = new FormData();
            formData.append('file', fileInput.files[0]);
            formData.append('folder', document.getElementById('uploadFolderSelect').value);
            formData.append('applyWatermark', document.getElementById('chkWatermark').checked);

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (token) {
                formData.append('__RequestVerificationToken', token);
            }

            const btnUpload = document.getElementById('btnUpload');
            btnUpload.disabled = true;
            btnUpload.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang tải...';
            document.getElementById('uploadProgressBar').classList.remove('d-none');

            try {
                const response = await fetch('@Url.Action("Upload", "Media", new { area = "Admin" })', {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': token || ''
                    },
                    body: formData
                });

                const data = await response.json();
                if (data.success) {
                    showToast(data.message, true);
                    cancelUpload();
                    setTimeout(() => location.reload(), 800);
                } else {
                    showToast(data.message || 'Lỗi khi tải ảnh lên.', false);
                }
            } catch (err) {
                showToast('Lỗi mạng kết nối: ' + err.message, false);
            } finally {
                btnUpload.disabled = false;
                btnUpload.innerHTML = '<i class="bi bi-upload me-1"></i> Tải Lên Ngay';
                document.getElementById('uploadProgressBar').classList.add('d-none');
            }
        }

        function copyFileUrl(url) {
            const fullUrl = window.location.origin + url;
            navigator.clipboard.writeText(fullUrl).then(() => {
                showToast('Đã sao chép đường dẫn ảnh vào Clipboard: ' + url, true);
            }).catch(() => {
                showToast('Không thể sao chép, vui lòng thử lại.', false);
            });
        }

        function openPreviewModal(url, name, size) {
            currentModalUrl = url;
            document.getElementById('modalFileName').innerText = name;
            document.getElementById('modalPreviewImage').src = url;
            document.getElementById('modalFileSize').innerText = 'Dung lượng: ' + size;
            document.getElementById('modalDirectLink').href = url;
            const modal = new bootstrap.Modal(document.getElementById('imagePreviewModal'));
            modal.show();
        }

        function copyCurrentModalUrl() {
            copyFileUrl(currentModalUrl);
        }

        async function deleteFile(fileUrl) {
            if (!confirm(`Bạn có chắc chắn muốn xóa vĩnh viễn tệp ảnh này khỏi kho lưu trữ?\n(${fileUrl})`)) {
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            formData.append('fileUrl', fileUrl);
            if (token) formData.append('__RequestVerificationToken', token);

            try {
                const response = await fetch('@Url.Action("Delete", "Media", new { area = "Admin" })', {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': token || ''
                    },
                    body: formData
                });

                const data = await response.json();
                if (data.success) {
                    showToast(data.message, true);
                    setTimeout(() => location.reload(), 600);
                } else {
                    showToast(data.message, false);
                }
            } catch (err) {
                showToast('Lỗi xóa tệp: ' + err.message, false);
            }
        }

        function filterMediaCards(keyword) {
            const term = (keyword || '').toLowerCase().trim();
            document.querySelectorAll('.media-card-item').forEach(el => {
                const name = el.getAttribute('data-filename') || '';
                if (!term || name.includes(term)) {
                    el.classList.remove('d-none');
                } else {
                    el.classList.add('d-none');
                }
            });
        }
    </script>
}
