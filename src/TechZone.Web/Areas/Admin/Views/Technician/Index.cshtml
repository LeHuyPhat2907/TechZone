@section Scripts {
    <script>
        function openRequestPartModal(partId, partCode, partName) {
            var select = document.getElementById("modalPartSelect");
            if (select) {
                select.value = partId;
            }
            var modal = new bootstrap.Modal(document.getElementById("requestSparePartModal"));
            modal.show();
        }

        function openEstimateModal(ticketId, ticketCode, partsCost, laborCost, discount, notes) {
            document.getElementById("estimateTicketId").value = ticketId;
            document.getElementById("estimateTicketCode").value = ticketCode;
            document.getElementById("estimateLaborCost").value = laborCost || 150000;
            document.getElementById("estimateDiscount").value = discount || 0;
            document.getElementById("estimateNotes").value = notes || "";
            var modal = new bootstrap.Modal(document.getElementById("estimateCostModal"));
            modal.show();
        }

        function openUpdateVendorRmaModal(id, code) {
            document.getElementById("updateVendorRmaId").value = id;
            document.getElementById("updateVendorRmaCode").value = code;
            var modal = new bootstrap.Modal(document.getElementById("updateVendorRmaModal"));
            modal.show();
        }
    </script>
}
