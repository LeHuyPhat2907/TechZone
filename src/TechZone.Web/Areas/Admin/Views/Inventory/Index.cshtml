@section Scripts {
    <script>
        function openAdjustModal(prodId, prodName, currentStock) {
            document.getElementById('adjustProductId').value = prodId;
            document.getElementById('adjustActualStock').value = currentStock;
            var modal = new bootstrap.Modal(document.getElementById('adjustStockModal'));
            modal.show();
        }

        document.getElementById('adjustProductId')?.addEventListener('change', function() {
            var selectedOpt = this.options[this.selectedIndex];
            var stock = selectedOpt.getAttribute('data-stock');
            if (stock !== null) {
                document.getElementById('adjustActualStock').value = stock;
            }
        });

        function openPaymentModal(supId, supName, currentDebt) {
            document.getElementById('paySupplierId').value = supId;
            document.getElementById('paySupplierName').innerText = supName;
            document.getElementById('paySupplierDebt').innerText = currentDebt.toLocaleString('vi-VN') + ' ₫';
            var modal = new bootstrap.Modal(document.getElementById('supplierPaymentModal'));
            modal.show();
        }

        function openEditSupplierModal(id, name, code, contact, phone, email, addr, tax, terms, note) {
            document.getElementById('editSupId').value = id;
            document.getElementById('editSupName').value = name;
            document.getElementById('editSupCode').value = code;
            document.getElementById('editSupContact').value = contact || '';
            document.getElementById('editSupPhone').value = phone || '';
            document.getElementById('editSupEmail').value = email || '';
            document.getElementById('editSupAddress').value = addr || '';
            document.getElementById('editSupTax').value = tax || '';
            document.getElementById('editSupTerms').value = terms || 'Net 30 ngày';
            document.getElementById('editSupNote').value = note || '';
            var modal = new bootstrap.Modal(document.getElementById('editSupplierModal'));
            modal.show();
        }
    </script>
}
