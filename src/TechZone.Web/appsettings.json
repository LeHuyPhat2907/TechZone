{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "TechZone": "Debug"
    }
  },
  "AllowedHosts": "*",
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "TechZoneDb"
  },
  "RedisSettings": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "TechZone:",
    "Enabled": true
  },
  "StorageSettings": {
    "Provider": "Local",
    "UploadDirectory": "uploads",
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".gif", ".svg" ],
    "Cloudinary": {
      "CloudName": "techzone-vn",
      "ApiKey": "",
      "ApiSecret": ""
    }
  }
}
