@model ProductComparisonDto
@{
    ViewData["Title"] = $"So Sánh {Model.Product1.Name} và {Model.Product2.Name}";
}

<div class="container my-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="Index" class="text-decoration-none text-muted">Sản phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">So sánh sản phẩm</li>
        </ol>
    </nav>

    <!-- Header Box with "Chỉ xem điểm khác biệt" switch (TGDD Killer Feature) -->
    <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary p-2"><i class="bi bi-arrow-left-right"></i></span>
                    <h1 class="h3 fw-bold text-dark m-0">So Sánh Thông Số Kỹ Thuật</h1>
                </div>
                <small class="text-muted mt-1 d-block">
                    Đối chiếu trực quan giữa <strong>@Model.Product1.Name</strong> và <strong>@Model.Product2.Name</strong>
                </small>
            </div>

            <!-- Actions: Swap, Pick Another & Toggle Filter -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <a asp-action="Compare" asp-route-p1="@Model.Product2.Slug" asp-route-p2="@Model.Product1.Slug" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Đổi chỗ 2 sản phẩm">
                    <i class="bi bi-arrow-left-right me-1"></i>Đổi vị trí
                </a>
                <a asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="Về danh mục chọn thiết bị khác">
                    <i class="bi bi-plus-circle me-1"></i>Chọn máy khác
                </a>
                <div class="d-flex align-items-center bg-light p-2 px-3 rounded-pill border">
                    <div class="form-check form-switch m-0 d-flex align-items-center gap-2 cursor-pointer">
                        <input class="form-check-input fs-5 cursor-pointer" type="checkbox" id="diffOnlyToggle" onchange="toggleDiffOnly(this.checked)" />
                        <label class="form-check-label fw-bold text-dark small cursor-pointer" for="diffOnlyToggle">
                            <i class="bi bi-eye-slash text-danger me-1"></i>Chỉ xem điểm khác biệt
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Comparison Table -->
    <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white mb-5">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="comparisonTable">
                <!-- Sticky Product Headers -->
                <thead class="bg-light border-bottom">
                    <tr>
                        <th style="width: 25%;" class="p-3 text-muted fw-semibold">Thông số / Tính năng</th>
                        <th style="width: 37.5%;" class="p-3 text-center border-start">
                            <div class="position-relative">
                                <span class="badge bg-light text-primary border mb-2">Chính Hãng VN/A</span>
                                <div class="mb-2" style="height: 160px;">
                                    <a asp-controller="Catalog" asp-action="Detail" asp-route-slug="@Model.Product1.Slug">
                                        <img src="@Model.Product1.ThumbnailUrl" alt="@Model.Product1.Name" class="h-100 object-fit-contain" />
                                    </a>
                                </div>
                                <h5 class="fw-bold mb-1">
                                    <a asp-controller="Catalog" asp-action="Detail" asp-route-slug="@Model.Product1.Slug" class="text-dark text-decoration-none">
                                        @Model.Product1.Name
                                    </a>
                                </h5>
                                <div class="fs-4 fw-bold text-danger mb-1">@Model.Product1.Price.ToString("N0")₫</div>
                                @if (Model.Product1.OriginalPrice > Model.Product1.Price)
                                {
                                    <small class="text-muted text-decoration-line-through d-block mb-1">@Model.Product1.OriginalPrice.ToString("N0")₫</small>
                                }
                                <div class="small text-muted mb-3 font-monospace" style="font-size: 0.75rem;">
                                    <i class="bi bi-credit-card-2-front text-success me-1"></i>@Model.Product1.InstallmentText
                                </div>
                                <button type="button" class="btn btn-sm btn-danger fw-bold px-4 py-2 rounded-3 w-75" onclick="addToCart('@Model.Product1.Id', '@Model.Product1.Sku', 1)">
                                    <i class="bi bi-cart-plus me-1"></i>Mua ngay
                                </button>
                            </div>
                        </th>
                        <th style="width: 37.5%;" class="p-3 text-center border-start">
                            <div class="position-relative">
                                <span class="badge bg-light text-primary border mb-2">Chính Hãng VN/A</span>
                                <div class="mb-2" style="height: 160px;">
                                    <a asp-controller="Catalog" asp-action="Detail" asp-route-slug="@Model.Product2.Slug">
                                        <img src="@Model.Product2.ThumbnailUrl" alt="@Model.Product2.Name" class="h-100 object-fit-contain" />
                                    </a>
                                </div>
                                <h5 class="fw-bold mb-1">
                                    <a asp-controller="Catalog" asp-action="Detail" asp-route-slug="@Model.Product2.Slug" class="text-dark text-decoration-none">
                                        @Model.Product2.Name
                                    </a>
                                </h5>
                                <div class="fs-4 fw-bold text-danger mb-1">@Model.Product2.Price.ToString("N0")₫</div>
                                @if (Model.Product2.OriginalPrice > Model.Product2.Price)
                                {
                                    <small class="text-muted text-decoration-line-through d-block mb-1">@Model.Product2.OriginalPrice.ToString("N0")₫</small>
                                }
                                <div class="small text-muted mb-3 font-monospace" style="font-size: 0.75rem;">
                                    <i class="bi bi-credit-card-2-front text-success me-1"></i>@Model.Product2.InstallmentText
                                </div>
                                <button type="button" class="btn btn-sm btn-danger fw-bold px-4 py-2 rounded-3 w-75" onclick="addToCart('@Model.Product2.Id', '@Model.Product2.Sku', 1)">
                                    <i class="bi bi-cart-plus me-1"></i>Mua ngay
                                </button>
                            </div>
                        </th>
                    </tr>
                </thead>

                <!-- Comparison Specs Body -->
                <tbody>
                    @{
                        string? lastGroup = null;
                    }
                    @foreach (var row in Model.Rows)
                    {
                        if (row.GroupName != lastGroup)
                        {
                            lastGroup = row.GroupName;
                            <tr class="table-secondary spec-group-header">
                                <td colspan="3" class="fw-bold text-dark text-uppercase small py-2 px-3">
                                    <i class="bi bi-bookmark-fill text-primary me-2"></i>@row.GroupName
                                </td>
                            </tr>
                        }

                        <tr class="spec-row @(row.IsDifferent ? "table-warning bg-opacity-25" : "")" data-diff="@row.IsDifferent.ToString().ToLower()">
                            <td class="fw-semibold text-muted px-3">
                                @row.SpecName
                                @if (row.IsDifferent)
                                {
                                    <span class="badge bg-warning text-dark ms-1 small" style="font-size: 0.65rem;">Khác biệt</span>
                                }
                            </td>
                            <td class="text-center border-start px-3 @(row.IsDifferent ? "fw-bold text-primary" : "")">
                                @row.Value1
                            </td>
                            <td class="text-center border-start px-3 @(row.IsDifferent ? "fw-bold text-primary" : "")">
                                @row.Value2
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleDiffOnly(showDiffOnly) {
            const rows = document.querySelectorAll('.spec-row');
            rows.forEach(row => {
                const isDiff = row.getAttribute('data-diff') === 'true';
                if (showDiffOnly && !isDiff) {
                    row.style.display = 'none';
                } else {
                    row.style.display = '';
                }
            });

            // Update group headers if all child rows are hidden
            const headers = document.querySelectorAll('.spec-group-header');
            headers.forEach(h => {
                let next = h.nextElementSibling;
                let hasVisible = false;
                while (next && !next.classList.contains('spec-group-header')) {
                    if (next.style.display !== 'none') {
                        hasVisible = true;
                        break;
                    }
                    next = next.nextElementSibling;
                }
                h.style.display = (showDiffOnly && !hasVisible) ? 'none' : '';
            });
        }
    </script>
}
