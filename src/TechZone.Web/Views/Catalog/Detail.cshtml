        <!-- Right: Community Q&A with Official QTV Responses -->
        <div class="col-lg-5">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white h-100">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-question-circle-fill text-primary me-2"></i>Hỏi Đáp Cộng Đồng (Q&A)</h5>
                
                <div class="d-flex flex-column gap-3">
                    <div class="p-3 bg-light rounded-3">
                        <div class="d-flex align-items-center gap-2 mb-1">
