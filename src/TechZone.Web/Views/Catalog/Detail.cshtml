@section Scripts {
    <script>
        let currentSelectedSku = '@(defaultVariant?.Sku ?? Model.Sku)';
        let currentProductPrice = @currentPrice;
        let currentInstallmentPeriod = 6;
        let currentPrepayPercent = 0;
        let currentReviewRating = 5;

        function changeMainImage(url) {
            document.getElementById('mainProductImage').src = url;
        }

        function setInstallmentPeriod(months) {
            currentInstallmentPeriod = months;
            document.querySelectorAll('.period-btn').forEach(b => {
                b.classList.remove('active', 'btn-primary');
                b.classList.add('btn-outline-primary');
            });
            const activeBtn = document.getElementById('btnPeriod' + months);
            if (activeBtn) {
                activeBtn.classList.remove('btn-outline-primary');
                activeBtn.classList.add('active', 'btn-primary');
            }
            updateInstallmentDisplay();
        }

        function setPrepayPercent(pct) {
            currentPrepayPercent = pct;
            document.querySelectorAll('.prepay-btn').forEach(b => {
                b.classList.remove('active', 'btn-secondary');
                b.classList.add('btn-outline-secondary');
            });
            const activeBtn = document.getElementById('btnPrepay' + pct);
            if (activeBtn) {
                activeBtn.classList.remove('btn-outline-secondary');
                activeBtn.classList.add('active', 'btn-secondary');
            }
            updateInstallmentDisplay();
        }

        function updateInstallmentDisplay() {
            const prepayAmount = Math.round(currentProductPrice * (currentPrepayPercent / 100));
            const remaining = currentProductPrice - prepayAmount;
            const monthly = Math.round(remaining / currentInstallmentPeriod / 1000) * 1000;

            const dispMonthly = document.getElementById('installmentMonthlyDisplay');
            if (dispMonthly) {
                dispMonthly.innerText = monthly.toLocaleString('vi-VN') + '₫/th';
            }

            const dispPrepay = document.getElementById('prepayAmountDisplay');
            if (dispPrepay) {
                dispPrepay.innerText = prepayAmount.toLocaleString('vi-VN') + `₫ (${currentPrepayPercent}%)`;
            }

            // Also recalculate Trade-in if open
            calculateTradeIn();
        }

        function selectVariant(element) {
            document.querySelectorAll('.variant-option-card').forEach(el => {
                el.classList.remove('border-primary', 'bg-primary-subtle');
                el.classList.add('border-secondary-subtle');
            });

            element.classList.remove('border-secondary-subtle');
            element.classList.add('border-primary', 'bg-primary-subtle');

            currentSelectedSku = element.getAttribute('data-sku');
            document.getElementById('currentSkuDisplay').innerText = currentSelectedSku;
            document.getElementById('currentPriceDisplay').innerText = element.getAttribute('data-price');
            
            const origPrice = element.getAttribute('data-orig-price');
            const origEl = document.getElementById('originalPriceDisplay');
            if (origEl && origPrice) {
                origEl.innerText = origPrice;
            }

            const rawPrice = parseFloat(element.getAttribute('data-price-raw'));
            if (!isNaN(rawPrice) && rawPrice > 0) {
                currentProductPrice = rawPrice;
                updateInstallmentDisplay();
                
                // Update Smember Loyalty Price
                const smemberP = Math.round((currentProductPrice * 0.985) / 1000) * 1000;
                const smemberEl = document.getElementById('smemberPriceDisplay');
                if (smemberEl) {
                    smemberEl.innerText = smemberP.toLocaleString('vi-VN') + '₫';
                }
            }

            const mobilePrice = document.getElementById('mobileStickyPrice');
            if (mobilePrice) {
                mobilePrice.innerText = element.getAttribute('data-price');
            }

            const imgUrl = element.getAttribute('data-image');
            if (imgUrl) {
                changeMainImage(imgUrl);
            }
        }

        function increaseQty() {
            const input = document.getElementById('selectedQuantity');
            let val = parseInt(input.value) || 1;
            if (val < 10) input.value = val + 1;
        }

        function decreaseQty() {
            const input = document.getElementById('selectedQuantity');
            let val = parseInt(input.value) || 1;
            if (val > 1) input.value = val - 1;
        }

        function handleAddToCart() {
            const qty = parseInt(document.getElementById('selectedQuantity').value) || 1;
            addToCart('@Model.Id', currentSelectedSku, qty);
        }

        function handleBuyNow() {
            const qty = parseInt(document.getElementById('selectedQuantity').value) || 1;
            fetch('/Cart/Add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId: '@Model.Id', variantSku: currentSelectedSku, quantity: qty })
            })
            .then(res => res.json())
            .then(data => {
                if (data.succeeded) {
                    window.location.href = '/Checkout';
                } else {
                    showToast(data.message || 'Lỗi đặt mua', false);
                }
            })
            .catch(() => {
                window.location.href = '/Checkout';
            });
        }

        // CellphoneS Trade-in Calculator
        function calculateTradeIn() {
            const select = document.getElementById('tradeInDeviceSelect');
            if (!select) return;

            const selectedOption = select.options[select.selectedIndex];
            const tradeVal = parseFloat(selectedOption.value) || 0;
            const subsidy = parseFloat(selectedOption.getAttribute('data-subsidy')) || 0;
            const resultBox = document.getElementById('tradeInResultBox');

            if (tradeVal > 0) {
                resultBox.style.display = 'block';
                document.getElementById('tradeInValDisplay').innerText = tradeVal.toLocaleString('vi-VN') + '₫';
                document.getElementById('tradeInSubsidyDisplay').innerText = '+' + subsidy.toLocaleString('vi-VN') + '₫';

                const totalDiscount = tradeVal + subsidy;
                const diff = Math.max(0, currentProductPrice - totalDiscount);
                document.getElementById('tradeInPayDiffDisplay').innerText = diff.toLocaleString('vi-VN') + '₫';
            } else {
                resultBox.style.display = 'none';
            }
        }

        function alertTradeInRegistration() {
            const select = document.getElementById('tradeInDeviceSelect');
            if (select.value === "0") {
                showToast('Vui lòng chọn model máy cũ cần thu đổi!', false);
                return;
            }
            showToast('Đã ghi nhận yêu cầu Thu Cũ Đổi Mới! Chuyên viên thẩm định TechZone sẽ liên hệ trong 15 phút.', true);
        }

        // CellphoneS Review Rating Picker
        const starDescriptions = {
            1: "1 sao - Rất không hài lòng",
            2: "2 sao - Không hài lòng",
            3: "3 sao - Bình thường",
            4: "4 sao - Hài lòng",
            5: "5 sao - Rất tuyệt vời"
        };

        function setRating(val) {
            currentReviewRating = val;
            const stars = document.querySelectorAll('#starRatingGroup i');
            stars.forEach((s, idx) => {
                if (idx < val) {
                    s.classList.remove('bi-star', 'text-secondary');
                    s.classList.add('bi-star-fill', 'text-warning');
                } else {
                    s.classList.remove('bi-star-fill', 'text-warning');
                    s.classList.add('bi-star', 'text-secondary');
                }
            });
            document.getElementById('ratingTextLabel').innerText = starDescriptions[val] || `${val} sao`;
        }

        function submitReviewAjax(e) {
            e.preventDefault();
            const author = document.getElementById('reviewAuthorName').value.trim();
            const phone = document.getElementById('reviewAuthorPhone').value.trim();
            const content = document.getElementById('reviewContentText').value.trim();
            const btn = document.getElementById('btnSubmitReview');

            if (!author || !content) {
                showToast('Vui lòng nhập đầy đủ họ tên và nội dung đánh giá!', false);
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang gửi...';

            fetch('/Catalog/SubmitReview', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    productId: '@Model.Id',
                    userName: author,
                    phoneNumber: phone,
                    rating: currentReviewRating,
                    content: content
                })
            })
            .then(res => res.json())
            .then(data => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send-fill me-1"></i>Gửi Đánh Giá Ngay';

                if (data.success) {
                    showToast(data.message || 'Gửi đánh giá thành công!', true);

                    // Prepend new review card to the list
                    const listContainer = document.getElementById('reviewsListContainer');
                    const starsHtml = Array.from({ length: 5 }, (_, i) => 
                        `<i class="bi ${i < currentReviewRating ? 'bi-star-fill' : 'bi-star'}"></i>`
                    ).join('');

                    const newRevHtml = `
                        <div class="border-bottom pb-3 bg-light-subtle p-2 rounded-3 border-start border-success border-3">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="fw-bold text-dark small">${author}</span>
                                <span class="badge bg-success-subtle text-success border border-success-subtle small" style="font-size: 0.65rem;">
                                    <i class="bi bi-check-circle-fill me-1"></i>Đã mua tại TechZone
                                </span>
                                <span class="text-muted small ms-auto" style="font-size: 0.75rem;">Vừa xong</span>
                            </div>
                            <div class="text-warning small mb-1">${starsHtml}</div>
                            <p class="small text-secondary mb-0">${content}</p>
                        </div>
                    `;

                    listContainer.insertAdjacentHTML('afterbegin', newRevHtml);

                    // Reset modal and close
                    document.getElementById('reviewSubmitForm').reset();
                    setRating(5);
                    const modalEl = document.getElementById('reviewModal');
                    const modalInstance = bootstrap.Modal.getInstance(modalEl);
                    if (modalInstance) modalInstance.hide();
                } else {
                    showToast(data.message || 'Lỗi gửi đánh giá', false);
                }
            })
            .catch(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send-fill me-1"></i>Gửi Đánh Giá Ngay';
                showToast('Lỗi kết nối máy chủ. Vui lòng thử lại!', false);
            });
        }
    </script>
}
