            </form>
        </div>
    </div>
</div>

<!-- 4. Modal Đánh Giá Sản Phẩm (Verified Buyer Only) -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-primary" id="reviewModalLabel"><i class="bi bi-star-fill text-warning me-2"></i>Đánh giá Sản phẩm Đã mua</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Member" asp-action="SubmitVerifiedReview" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="orderId" id="reviewModalOrderId" />
                    <input type="hidden" name="productId" id="reviewModalProductId" />
                    
                    <div class="text-center mb-3">
                        <div class="fw-bold fs-6 text-dark" id="reviewModalProductName">Sản phẩm</div>
                        <span class="badge bg-success-subtle text-success small"><i class="bi bi-patch-check-fill me-1"></i>Verified Purchase (Đã xác thực đã mua hàng)</span>
                    </div>

                    <div class="mb-3 text-center">
                        <label class="form-label small fw-bold d-block">Chất lượng trải nghiệm</label>
                        <select name="rating" class="form-select text-center fw-bold text-warning mx-auto" style="max-width: 200px;">
                            <option value="5" selected>⭐⭐⭐⭐⭐ Tuyệt vời (5 sao)</option>
                            <option value="4">⭐⭐⭐⭐ Hài lòng (4 sao)</option>
                            <option value="3">⭐⭐⭐ Bình thường (3 sao)</option>
                            <option value="2">⭐⭐ Chưa hài lòng (2 sao)</option>
                            <option value="1">⭐ Rất tệ (1 sao)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Cảm nhận thực tế của bạn *</label>
                        <textarea name="content" class="form-control" rows="3" placeholder="Chia sẻ về độ mượt, camera, pin hoặc dịch vụ giao hàng..." required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Link Ảnh chụp thực tế sản phẩm (Không bắt buộc)</label>
                        <input type="url" name="imageUrl" class="form-control" placeholder="https://..." />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Gửi đánh giá</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Modal Handlers
        const cancelModal = document.getElementById('cancelOrderModal');
        if (cancelModal) {
            cancelModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const orderId = button.getAttribute('data-order-id');
                const orderCode = button.getAttribute('data-order-code');
                document.getElementById('cancelModalOrderId').value = orderId;
                document.getElementById('cancelModalOrderCode').textContent = '#' + orderCode;
            });
        }

        const returnModal = document.getElementById('returnRequestModal');
        if (returnModal) {
            returnModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const orderId = button.getAttribute('data-order-id');
                document.getElementById('returnModalOrderId').value = orderId;
            });
        }

        const reviewModal = document.getElementById('reviewModal');
        if (reviewModal) {
            reviewModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const orderId = button.getAttribute('data-order-id');
                const productId = button.getAttribute('data-product-id');
                const productName = button.getAttribute('data-product-name');
                document.getElementById('reviewModalOrderId').value = orderId;
                document.getElementById('reviewModalProductId').value = productId;
                document.getElementById('reviewModalProductName').textContent = productName;
            });
        }

        // Inline Wishlist Toggle
        async function toggleWishlistInline(productId) {
            try {
                const response = await fetch('/Member/ToggleWishlist', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(productId)
                });
                const result = await response.json();
                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || 'Không thể cập nhật danh sách yêu thích');
                }
            } catch (err) {
                console.error(err);
            }
        }
    </script>
}
