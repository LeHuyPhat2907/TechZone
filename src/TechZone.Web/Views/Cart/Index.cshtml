@model CartDto
@{
    ViewData["Title"] = "Giỏ Hàng Công Nghệ - TechZone";
}

<div class="container my-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Giỏ hàng của bạn</li>
        </ol>
    </nav>

    <h3 class="fw-bold text-dark mb-4"><i class="bi bi-cart3 text-primary me-2"></i>Giỏ Hàng Của Bạn (@Model.TotalItems sản phẩm)</h3>

    @if (Model.Items.Count > 0)
    {
        <div class="row g-4">
            <!-- Left: Cart Items List -->
            <div class="col-lg-8">
                <div class="card border-0 rounded-4 shadow-sm p-3 bg-white mb-3">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="text-secondary small text-uppercase bg-light">
                                <tr>
                                    <th style="min-width: 280px;">Sản phẩm</th>
                                    <th>Đơn giá</th>
                                    <th style="width: 130px;">Số lượng</th>
                                    <th>Thành tiền</th>
                                    <th style="width: 40px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr id="cart-row-@item.VariantSku">
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@item.ThumbnailUrl" alt="@item.ProductName" class="rounded-3 border p-1" style="width: 65px; height: 65px; object-fit: contain;" />
                                                <div>
                                                    <a asp-controller="Catalog" asp-action="Detail" asp-route-slug="@item.ProductSlug" class="fw-bold text-dark text-decoration-none small d-block">
                                                        @item.ProductName
                                                    </a>
                                                    <span class="badge bg-light text-secondary border small">@item.VariantName</span>
                                                    <div class="text-muted small mt-1"><i class="bi bi-shield-check text-success me-1"></i>Bảo hành @item.WarrantyMonths tháng</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fw-semibold text-dark">@item.Price.ToString("N0")₫</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center border rounded-3 overflow-hidden bg-light" style="max-width: 100px;">
                                                <button type="button" class="btn btn-sm btn-light border-0 px-2" onclick="updateItemQuantity('@item.VariantSku', @(item.Quantity - 1))">-</button>
                                                <span class="form-control form-control-sm text-center border-0 bg-transparent fw-bold p-0">@item.Quantity</span>
                                                <button type="button" class="btn btn-sm btn-light border-0 px-2" onclick="updateItemQuantity('@item.VariantSku', @(item.Quantity + 1))">+</button>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fw-bold text-danger">@item.LineTotal.ToString("N0")₫</span>
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm text-danger border-0" title="Xóa khỏi giỏ" onclick="removeItem('@item.VariantSku')">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Tiếp tục xem sản phẩm
                    </a>
                </div>
            </div>

            <!-- Right: Order Summary Box -->
            <div class="col-lg-4">
                <div class="card border-0 rounded-4 shadow-sm p-4 bg-white sticky-top" style="top: 90px;">
                    <h5 class="fw-bold text-dark mb-3">Tóm Tắt Đơn Hàng</h5>

                    <div class="d-flex justify-content-between mb-2 small text-secondary">
                        <span>Tạm tính hàng hóa:</span>
                        <span id="summarySubtotal" class="fw-bold text-dark">@Model.Subtotal.ToString("N0")₫</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 small text-secondary">
                        <span>Phí vận chuyển dự tính:</span>
                        <span id="summaryShipping" class="fw-bold @(Model.EstimatedShippingFee == 0 ? "text-success" : "text-dark")">
                            @(Model.EstimatedShippingFee == 0 ? "Miễn phí" : Model.EstimatedShippingFee.ToString("N0") + "₫")
                        </span>
                    </div>

                    <div class="p-2 bg-light rounded-3 small text-muted mb-3">
                        <i class="bi bi-info-circle text-primary me-1"></i>
                        Đơn từ 500.000đ được <strong>miễn phí giao hàng</strong> toàn quốc.
                    </div>

                    <!-- 6.2 coupon.simulate: Nhập thử mã voucher công khai -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark"><i class="bi bi-ticket-perforated text-danger me-1"></i>Nhập mã ưu đãi (Thử voucher):</label>
                        <div class="input-group">
                            <input type="text" id="couponSimulateInput" class="form-control form-control-sm text-uppercase" placeholder="VD: TECHZONE500, FREESHIP..." />
                            <button type="button" class="btn btn-sm btn-outline-danger fw-semibold" onclick="simulateCouponClick()">Áp dụng</button>
                        </div>
                        <div id="couponSimulateFeedback" class="small mt-1 d-none"></div>
                    </div>

                    <div id="couponDiscountRow" class="d-none justify-content-between mb-2 small text-success fw-bold">
                        <span>Giảm giá voucher (<span id="couponAppliedCode"></span>):</span>
                        <span id="couponDiscountAmount">-0₫</span>
                    </div>

                    <hr class="text-muted opacity-25" />

                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                        <span class="fw-bold text-dark">Tổng tiền dự kiến:</span>
                        <span id="summaryTotal" class="fs-4 fw-bold text-danger">@Model.EstimatedTotal.ToString("N0")₫</span>
                    </div>

                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-danger btn-lg w-100 fw-bold py-3 rounded-3 shadow-sm">
                        Tiến Hành Đặt Hàng <i class="bi bi-arrow-right ms-2"></i>
                    </a>

                    <div class="text-center mt-3">
                        <small class="text-muted"><i class="bi bi-shield-lock me-1"></i>Thanh toán an toàn & bảo mật 100%</small>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 rounded-4 shadow-sm p-5 text-center bg-white my-5">
            <i class="bi bi-cart-x text-muted display-3 mb-3"></i>
            <h4 class="fw-bold text-dark">Giỏ hàng của bạn đang trống</h4>
            <p class="text-muted">Hãy chọn những thiết bị công nghệ đỉnh cao và thêm vào giỏ nhé!</p>
            <div class="mt-3">
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                    <i class="bi bi-grid me-2"></i>Khám phá sản phẩm ngay
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateItemQuantity(variantSku, newQty) {
            fetch('/Cart/UpdateQuantity', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ variantSku: variantSku, quantity: newQty })
            })
            .then(res => res.json())
            .then(data => {
                if (data.succeeded) {
                    window.location.reload();
                }
            });
        }

        function removeItem(variantSku) {
            fetch('/Cart/Remove', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ variantSku: variantSku })
            })
            .then(res => res.json())
            .then(data => {
                if (data.succeeded) {
                    window.location.reload();
                }
            });
        }

        async function simulateCouponClick() {
            const input = document.getElementById('couponSimulateInput');
            const feedback = document.getElementById('couponSimulateFeedback');
            const discountRow = document.getElementById('couponDiscountRow');
            const codeSpan = document.getElementById('couponAppliedCode');
            const amountSpan = document.getElementById('couponDiscountAmount');
            const totalSpan = document.getElementById('summaryTotal');

            const code = input.value.trim();
            if (!code) {
                feedback.className = 'small mt-1 text-danger';
                feedback.textContent = 'Vui lòng nhập mã giảm giá.';
                feedback.classList.remove('d-none');
                return;
            }

            try {
                const response = await fetch('/Cart/SimulateCoupon', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ couponCode: code })
                });
                const result = await response.json();

                if (result.succeeded) {
                    feedback.className = 'small mt-1 text-success';
                    feedback.textContent = result.message;
                    feedback.classList.remove('d-none');

                    discountRow.classList.remove('d-none');
                    discountRow.classList.add('d-flex');
                    codeSpan.textContent = result.code;
                    amountSpan.textContent = '-' + result.discountAmountText;
                    totalSpan.textContent = result.newTotalText;
                } else {
                    feedback.className = 'small mt-1 text-danger';
                    feedback.textContent = result.message;
                    feedback.classList.remove('d-none');
                    discountRow.classList.add('d-none');
                    discountRow.classList.remove('d-flex');
                }
            } catch (err) {
                console.error(err);
                feedback.className = 'small mt-1 text-danger';
                feedback.textContent = 'Lỗi kết nối khi kiểm tra voucher. Vui lòng thử lại.';
                feedback.classList.remove('d-none');
            }
        }
    </script>
}
